{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sops.org/schemas/v1/common/ErrorContract.json",
  "title": "ErrorContract",
  "description": "Standardized machine-readable error payload.",
  "type": "object",
  "required": [
    "code",
    "message"
  ],
  "properties": {
    "code": {
      "type": "string",
      "description": "Stable machine-readable error code (e.g., 'ERR_NOT_FOUND', 'ERR_PRICE_VIOLATION')."
    },
    "message": {
      "type": "string",
      "description": "Human-readable error description."
    },
    "target": {
      "type": [
        "string",
        "null"
      ],
      "description": "Field or resource that caused the failure."
    },
    "details": {
      "type": [
        "object",
        "null"
      ],
      "description": "Optional additional structured diagnostic data."
    }
  },
  "additionalProperties": false
}
