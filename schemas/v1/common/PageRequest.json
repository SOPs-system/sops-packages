{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sops.org/schemas/v1/common/PageRequest.json",
  "title": "PageRequest",
  "description": "Pagination parameters for list queries.",
  "type": "object",
  "required": [
    "page_number",
    "page_size"
  ],
  "properties": {
    "page_number": {
      "type": "integer",
      "minimum": 1
    },
    "page_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "search_term": {
      "type": [
        "string",
        "null"
      ]
    },
    "sort_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "sort_descending": {
      "type": "boolean",
      "default": false
    }
  },
  "additionalProperties": false
}
