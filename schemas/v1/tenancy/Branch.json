{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sops.org/schemas/v1/tenancy/Branch.json",
  "title": "Branch",
  "description": "Tenant branch projection for physical branch or warehouse operations.",
  "type": "object",
  "required": [
    "id",
    "chain_id",
    "branch_code",
    "name",
    "address",
    "phone",
    "is_active"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "chain_id": {
      "type": "string",
      "format": "uuid"
    },
    "global_pharmacy_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "branch_code": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "is_warehouse": {
      "type": "boolean",
      "default": false
    },
    "address": {
      "$ref": "../common/Address.json"
    },
    "phone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "manager_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false
}
