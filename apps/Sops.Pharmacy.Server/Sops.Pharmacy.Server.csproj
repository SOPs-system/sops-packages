<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <StartupObject>Sops.Pharmacy.Server.Program</StartupObject>
    <UseWPF>true</UseWPF>
    <Prefer32Bit>false</Prefer32Bit>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Sops.Pharmacy.Server</RootNamespace>
    <AssemblyName>Sops.Pharmacy.Server</AssemblyName>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.ServiceProcess" />
    <Reference Include="System.Configuration.Install" />
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlcipher" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.Extensions.Configuration" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

  <ItemGroup Condition="'$(OS)' == 'Windows_NT'">
    <None Include="$(NuGetPackageRoot)\sqlitepclraw.lib.e_sqlcipher\2.1.10\runtimes\win-x86\native\e_sqlcipher.dll" Condition="Exists('$(NuGetPackageRoot)\sqlitepclraw.lib.e_sqlcipher\2.1.10\runtimes\win-x86\native\e_sqlcipher.dll')">
      <Link>runtimes\win-x86\native\e_sqlcipher.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(NuGetPackageRoot)\sqlitepclraw.lib.e_sqlcipher\2.1.10\runtimes\win-x64\native\e_sqlcipher.dll" Condition="Exists('$(NuGetPackageRoot)\sqlitepclraw.lib.e_sqlcipher\2.1.10\runtimes\win-x64\native\e_sqlcipher.dll')">
      <Link>runtimes\win-x64\native\e_sqlcipher.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sop.Ui\Sop.Ui.csproj" />
    <ProjectReference Include="..\..\src\Sops.Models\packages\csharp\Sops.Models\Sops.Models.csproj" />
    <ProjectReference Include="..\..\src\Sops.Database\Sops.Database.csproj" />
    <ProjectReference Include="..\..\src\Sops.DataLayer\Sops.DataLayer.csproj" />
    <ProjectReference Include="..\..\src\Sops.DataOperations\Sops.DataOperations.csproj" />
    <ProjectReference Include="..\..\src\Sops.Drugs\Sops.Drugs.csproj" />
    <ProjectReference Include="..\..\src\Sops.Device\Sops.Device.csproj" />
    <ProjectReference Include="..\..\src\Sops.Licensing\Sops.Licensing.csproj" />
    <ProjectReference Include="..\..\src\Sops.Configuration\Sops.Configuration.csproj" />
    <ProjectReference Include="..\..\src\Sops.Logging\Sops.Logging.csproj" />
    <ProjectReference Include="..\..\src\Sops.Cache\Sops.Cache.csproj" />
  </ItemGroup>

</Project>
