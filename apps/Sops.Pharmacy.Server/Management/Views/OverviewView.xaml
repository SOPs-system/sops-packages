<UserControl x:Class="Sops.Pharmacy.Server.Management.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="https://sops.dev/ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <!-- Header Section -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Server Overview &amp; Live Telemetry" 
                               FontSize="{DynamicResource Text.Xl}" 
                               FontWeight="Bold" 
                               Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="Authoritative local server telemetry, encrypted SQLCipher health, and connected POS terminals." 
                               FontSize="{DynamicResource Text.Sm}" 
                               Foreground="{DynamicResource Brush.InkSubtle}" 
                               Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Badge Content="{Binding ServerStatusText}" 
                              Variant="success" 
                              Margin="0,0,12,0" />
                    <ui:Button Content="Refresh Now" 
                               Variant="secondary" 
                               Size="sm" 
                               Click="OnRefreshClicked" />
                </StackPanel>
            </Grid>

            <!-- Metrics Cards Grid -->
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <ui:Card Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Server Uptime" FontSize="{DynamicResource Text.Xs}" Foreground="{DynamicResource Brush.InkSubtle}" />
                        <TextBlock Text="{Binding Uptime}" FontSize="{DynamicResource Text.Xl}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,4,0,4" />
                        <TextBlock Text="Operational" FontSize="{DynamicResource Text.Xs}" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Active POS Terminals" FontSize="{DynamicResource Text.Xs}" Foreground="{DynamicResource Brush.InkSubtle}" />
                        <TextBlock Text="{Binding ActiveTerminalsCount}" FontSize="{DynamicResource Text.Xl}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,4,0,4" />
                        <TextBlock Text="Licensed seats OK" FontSize="{DynamicResource Text.Xs}" Foreground="{DynamicResource Brush.Success}" FontWeight="SemiBold" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Margin="0,0,12,0" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Encrypted DB Size" FontSize="{DynamicResource Text.Xs}" Foreground="{DynamicResource Brush.InkSubtle}" />
                        <TextBlock Text="{Binding DatabaseSizeFormatted}" FontSize="{DynamicResource Text.Xl}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,4,0,4" />
                        <TextBlock Text="SQLCipher 4.x WAL" FontSize="{DynamicResource Text.Xs}" Foreground="{DynamicResource Brush.InkMuted}" />
                    </StackPanel>
                </ui:Card>
                <ui:Card Padding="16">
                    <StackPanel>
                        <TextBlock Text="Memory Working Set" FontSize="{DynamicResource Text.Xs}" Foreground="{DynamicResource Brush.InkSubtle}" />
                        <TextBlock Text="{Binding MemoryUsageMb, StringFormat='{}{0} MB'}" FontSize="{DynamicResource Text.Xl}" FontWeight="Bold" Foreground="{DynamicResource Brush.Ink}" Margin="0,4,0,4" />
                        <TextBlock Text="Within budget" FontSize="{DynamicResource Text.Xs}" Foreground="{DynamicResource Brush.InkMuted}" />
                    </StackPanel>
                </ui:Card>
            </UniformGrid>

            <!-- Server Architecture & Operational State Banner -->
            <Border Background="{DynamicResource Brush.Surface}" 
                    BorderBrush="{DynamicResource Brush.Line}" 
                    BorderThickness="1" 
                    CornerRadius="{DynamicResource Radius.Md}" 
                    Padding="20" 
                    Margin="0,0,0,24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Active Storage &amp; Isolation Architecture" 
                                   FontSize="{DynamicResource Text.Base}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Text="Database: SQLCipher 256-bit AES encrypted file on local disk with PRAGMA busy_timeout=5000 and write-ahead logging (WAL). Client POS connections authenticate via local LAN RPC." 
                                   FontSize="{DynamicResource Text.Sm}" 
                                   Foreground="{DynamicResource Brush.InkSubtle}" 
                                   TextWrapping="Wrap" 
                                   Margin="0,6,0,0" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Badge Content="AES-256 Validated" Variant="neutral" Margin="0,0,8,0" />
                            <ui:Badge Content="Zero Cloud Dependency For Local Sales" Variant="neutral" Margin="0,0,8,0" />
                            <ui:Badge Content="Automatic Background Backups" Variant="neutral" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <ui:Button Content="Perform Backup Now" 
                                   Variant="primary" 
                                   Size="md" 
                                   Click="OnQuickBackupClicked" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Sync & Outbox Summary -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" 
                        Background="{DynamicResource Brush.Surface}" 
                        BorderBrush="{DynamicResource Brush.Line}" 
                        BorderThickness="1" 
                        CornerRadius="{DynamicResource Radius.Md}" 
                        Padding="16" 
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Durable Outbox Queue (Offline-first)" 
                                   FontSize="{DynamicResource Text.Base}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Text="Local transactions pending cloud synchronization acknowledgment." 
                                   FontSize="{DynamicResource Text.Xs}" 
                                   Foreground="{DynamicResource Brush.InkSubtle}" 
                                   Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PendingOutboxCount}" 
                                       FontSize="{DynamicResource Text.2xl}" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource Brush.Ink}" />
                            <TextBlock Text=" events queued" 
                                       FontSize="{DynamicResource Text.Sm}" 
                                       Foreground="{DynamicResource Brush.InkMuted}" 
                                       VerticalAlignment="Bottom" 
                                       Margin="8,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" 
                        Background="{DynamicResource Brush.Surface}" 
                        BorderBrush="{DynamicResource Brush.Line}" 
                        BorderThickness="1" 
                        CornerRadius="{DynamicResource Radius.Md}" 
                        Padding="16">
                    <StackPanel>
                        <TextBlock Text="Inbound Cloud Delta Stream" 
                                   FontSize="{DynamicResource Text.Base}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Text="Catalog and regulatory changes awaiting local transactional application." 
                                   FontSize="{DynamicResource Text.Xs}" 
                                   Foreground="{DynamicResource Brush.InkSubtle}" 
                                   Margin="0,4,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PendingInboxCount}" 
                                       FontSize="{DynamicResource Text.2xl}" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource Brush.Ink}" />
                            <TextBlock Text=" updates pending" 
                                       FontSize="{DynamicResource Text.Sm}" 
                                       Foreground="{DynamicResource Brush.InkMuted}" 
                                       VerticalAlignment="Bottom" 
                                       Margin="8,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
