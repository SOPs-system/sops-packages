<UserControl x:Class="Sops.Pharmacy.Server.Management.Views.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="https://sops.dev/ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="SQLCipher Encrypted Database" 
                       FontSize="{DynamicResource Text.Xl}" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="Local physical storage status, cryptographic integrity, WAL maintenance, and schema versioning." 
                       FontSize="{DynamicResource Text.Sm}" 
                       Foreground="{DynamicResource Brush.InkSubtle}" 
                       Margin="0,4,0,24" />

            <!-- Configuration & Status -->
            <Border Background="{DynamicResource Brush.Surface}" 
                    BorderBrush="{DynamicResource Brush.Line}" 
                    BorderThickness="1" 
                    CornerRadius="{DynamicResource Radius.Md}" 
                    Padding="20" 
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Cryptographic &amp; Storage Parameters" 
                               FontSize="{DynamicResource Text.Base}" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Ink}" 
                               Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Engine &amp; Driver:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="SQLCipher 4.x via SQLitePCLRaw.bundle_e_sqlcipher (Verified)" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Encryption Standard:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="AES-256-CBC with HMAC-SHA512 Key Derivation" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Journal Mode:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="Write-Ahead Logging (WAL) — concurrent readers, single atomic writer" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Busy Timeout:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="5000 ms with automatic exponential backoff" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Current Database Size:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="{Binding DatabaseSizeFormatted}" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Maintenance & Integrity Actions -->
            <Border Background="{DynamicResource Brush.Surface}" 
                    BorderBrush="{DynamicResource Brush.Line}" 
                    BorderThickness="1" 
                    CornerRadius="{DynamicResource Radius.Md}" 
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Integrity Verification &amp; Maintenance" 
                               FontSize="{DynamicResource Text.Base}" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="Execute cryptographic and B-Tree structure validation against the encrypted database." 
                               FontSize="{DynamicResource Text.Sm}" 
                               Foreground="{DynamicResource Brush.InkSubtle}" 
                               Margin="0,2,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:Button Content="Execute Integrity Check" 
                                   Variant="primary" 
                                   Size="md" 
                                   Margin="0,0,12,0" 
                                   Click="OnIntegrityCheckClicked" />
                        <ui:Button Content="Vacuum &amp; Defragment" 
                                   Variant="secondary" 
                                   Size="md" 
                                   Click="OnVacuumClicked" />
                    </StackPanel>

                    <TextBlock x:Name="TxtDbResult" 
                               FontSize="{DynamicResource Text.Sm}" 
                               FontFamily="{DynamicResource Font.Mono}" 
                               Foreground="{DynamicResource Brush.InkSubtle}" 
                               Text="Status: No checks executed yet." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
