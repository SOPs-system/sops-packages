<UserControl x:Class="Sops.Pharmacy.Server.Management.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="https://sops.dev/ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="Server Configuration &amp; UI Preferences" 
                       FontSize="{DynamicResource Text.Xl}" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="Network bindings, local storage paths, automated intervals, and management visual preferences." 
                       FontSize="{DynamicResource Text.Sm}" 
                       Foreground="{DynamicResource Brush.InkSubtle}" 
                       Margin="0,4,0,24" />

            <!-- Appearance Card -->
            <Border Background="{DynamicResource Brush.Surface}" 
                    BorderBrush="{DynamicResource Brush.Line}" 
                    BorderThickness="1" 
                    CornerRadius="{DynamicResource Radius.Md}" 
                    Padding="20" 
                    Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Appearance &amp; Language" 
                               FontSize="{DynamicResource Text.Base}" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Ink}" 
                               Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Color Theme Mode" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                            <TextBlock Text="Switch between light and high-contrast dark palette tokens." FontSize="{DynamicResource Text.Xs}" Foreground="{DynamicResource Brush.InkSubtle}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" 
                                   Content="Toggle Light / Dark" 
                                   Variant="secondary" 
                                   Size="md" 
                                   Click="OnToggleThemeClicked" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Layout Direction &amp; Script (RTL / LTR)" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                            <TextBlock Text="Full bi-directional layout support for English and Arabic pharmacy environments." FontSize="{DynamicResource Text.Xs}" Foreground="{DynamicResource Brush.InkSubtle}" />
                        </StackPanel>
                        <ui:Button Grid.Column="1" 
                                   Content="Toggle Arabic RTL / LTR" 
                                   Variant="secondary" 
                                   Size="md" 
                                   Click="OnToggleRtlClicked" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Storage & Paths Card -->
            <Border Background="{DynamicResource Brush.Surface}" 
                    BorderBrush="{DynamicResource Brush.Line}" 
                    BorderThickness="1" 
                    CornerRadius="{DynamicResource Radius.Md}" 
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Storage Paths &amp; Network Port" 
                               FontSize="{DynamicResource Text.Base}" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Ink}" 
                               Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Database Location:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="%ProgramData%\Sops\PharmacyServer\sops_pharmacy.db" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Backup Directory:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="%ProgramData%\Sops\PharmacyServer\Backups" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Default Service Port:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="5040 (HTTP/JSON-RPC)" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Scheduled Backup:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="Every 6 Hours (Automatic background task)" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
