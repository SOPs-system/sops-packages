<UserControl x:Class="Sops.Pharmacy.Server.Management.Views.ServerControlView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="https://sops.dev/ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="Server Runtime &amp; Service Control" 
                       FontSize="{DynamicResource Text.Xl}" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="Manage the underlying Windows service, network endpoints, loopback RPC listener, and diagnostics." 
                       FontSize="{DynamicResource Text.Sm}" 
                       Foreground="{DynamicResource Brush.InkSubtle}" 
                       Margin="0,4,0,24" />

            <!-- Service Control Card -->
            <Border Background="{DynamicResource Brush.Surface}" 
                    BorderBrush="{DynamicResource Brush.Line}" 
                    BorderThickness="1" 
                    CornerRadius="{DynamicResource Radius.Md}" 
                    Padding="20" 
                    Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Local Server Service State" 
                                       FontSize="{DynamicResource Text.Base}" 
                                       FontWeight="SemiBold" 
                                       Foreground="{DynamicResource Brush.Ink}" />
                            <TextBlock Text="SopsPharmacyServer Windows Service on LocalMachine." 
                                       FontSize="{DynamicResource Text.Sm}" 
                                       Foreground="{DynamicResource Brush.InkSubtle}" 
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:Badge Grid.Column="1" 
                                  Content="{Binding ServerStatusText}" 
                                  Variant="success" 
                                  VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:Button Content="Check / Ping Health" 
                                   Variant="secondary" 
                                   Size="md" 
                                   Margin="0,0,12,0" 
                                   Click="OnPingHealthClicked" />
                        <ui:Button Content="Ensure Service Started" 
                                   Variant="primary" 
                                   Size="md" 
                                   Margin="0,0,12,0" 
                                   Click="OnStartServiceClicked" />
                    </StackPanel>

                    <TextBlock x:Name="TxtPingResult" 
                               FontSize="{DynamicResource Text.Sm}" 
                               FontFamily="{DynamicResource Font.Mono}" 
                               Foreground="{DynamicResource Brush.InkSubtle}" 
                               Text="Ping status: Ready" />
                </StackPanel>
            </Border>

            <!-- Network Endpoints Configuration Card -->
            <Border Background="{DynamicResource Brush.Surface}" 
                    BorderBrush="{DynamicResource Brush.Line}" 
                    BorderThickness="1" 
                    CornerRadius="{DynamicResource Radius.Md}" 
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Active Network Endpoints" 
                               FontSize="{DynamicResource Text.Base}" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="Addresses registered for authenticated LAN and loopback RPC requests." 
                               FontSize="{DynamicResource Text.Sm}" 
                               Foreground="{DynamicResource Brush.InkSubtle}" 
                               Margin="0,2,0,16" />

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Loopback Interface:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="http://127.0.0.1:5040/ (Active, Management Console)" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Local LAN Interface:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="http://0.0.0.0:5040/ (Approved POS &amp; Mobile Clients)" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="RPC Protocol:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="JSON-RPC 2.0 / REST Envelopes (Sops.DataLayer)" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Target Platform:" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Grid.Column="1" Text="Windows 7 SP1 (x86/x64) through Windows 11 (.NET Framework 4.8)" Foreground="{DynamicResource Brush.InkSubtle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
