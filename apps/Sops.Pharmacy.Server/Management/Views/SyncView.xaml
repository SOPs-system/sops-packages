<UserControl x:Class="Sops.Pharmacy.Server.Management.Views.SyncView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="https://sops.dev/ui">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24">
            <TextBlock Text="Offline-First Cloud Synchronization" 
                       FontSize="{DynamicResource Text.Xl}" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource Brush.Ink}" />
            <TextBlock Text="Transactional Outbox &amp; Inbox pattern ensuring reliable, ordered, at-least-once delivery to SOPs cloud." 
                       FontSize="{DynamicResource Text.Sm}" 
                       Foreground="{DynamicResource Brush.InkSubtle}" 
                       Margin="0,4,0,24" />

            <UniformGrid Columns="2" Margin="0,0,0,24">
                <Border Background="{DynamicResource Brush.Surface}" 
                        BorderBrush="{DynamicResource Brush.Line}" 
                        BorderThickness="1" 
                        CornerRadius="{DynamicResource Radius.Md}" 
                        Padding="20" 
                        Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Outbox Queue (Upstream)" 
                                   FontSize="{DynamicResource Text.Base}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Text="Events queued locally waiting for cloud ACK." 
                                   FontSize="{DynamicResource Text.Sm}" 
                                   Foreground="{DynamicResource Brush.InkSubtle}" 
                                   Margin="0,2,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PendingOutboxCount}" 
                                       FontSize="{DynamicResource Text.2xl}" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource Brush.Ink}" />
                            <TextBlock Text=" events pending" 
                                       FontSize="{DynamicResource Text.Sm}" 
                                       Foreground="{DynamicResource Brush.InkMuted}" 
                                       VerticalAlignment="Bottom" 
                                       Margin="8,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource Brush.Surface}" 
                        BorderBrush="{DynamicResource Brush.Line}" 
                        BorderThickness="1" 
                        CornerRadius="{DynamicResource Radius.Md}" 
                        Padding="20">
                    <StackPanel>
                        <TextBlock Text="Inbox Delta Queue (Downstream)" 
                                   FontSize="{DynamicResource Text.Base}" 
                                   FontWeight="SemiBold" 
                                   Foreground="{DynamicResource Brush.Ink}" />
                        <TextBlock Text="Inbound events awaiting local database application." 
                                   FontSize="{DynamicResource Text.Sm}" 
                                   Foreground="{DynamicResource Brush.InkSubtle}" 
                                   Margin="0,2,0,12" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding PendingInboxCount}" 
                                       FontSize="{DynamicResource Text.2xl}" 
                                       FontWeight="Bold" 
                                       Foreground="{DynamicResource Brush.Ink}" />
                            <TextBlock Text=" updates pending" 
                                       FontSize="{DynamicResource Text.Sm}" 
                                       Foreground="{DynamicResource Brush.InkMuted}" 
                                       VerticalAlignment="Bottom" 
                                       Margin="8,0,0,4" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Sync Controls & Policy -->
            <Border Background="{DynamicResource Brush.Surface}" 
                    BorderBrush="{DynamicResource Brush.Line}" 
                    BorderThickness="1" 
                    CornerRadius="{DynamicResource Radius.Md}" 
                    Padding="20">
                <StackPanel>
                    <TextBlock Text="Sync Trigger &amp; Conflict Resolution Policy" 
                               FontSize="{DynamicResource Text.Base}" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Ink}" 
                               Margin="0,0,0,16" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <ui:Button Content="Trigger Immediate Sync" 
                                   Variant="primary" 
                                   Size="md" 
                                   Margin="0,0,12,0" 
                                   Click="OnTriggerSyncClicked" />
                    </StackPanel>

                    <TextBlock x:Name="TxtSyncStatus" 
                               FontSize="{DynamicResource Text.Sm}" 
                               FontFamily="{DynamicResource Font.Mono}" 
                               Foreground="{DynamicResource Brush.InkSubtle}" 
                               Text="Last sync cycle: Idempotent checkpoint recorded." 
                               Margin="0,0,0,16" />

                    <TextBlock Text="Conflict Resolution Strategy:" 
                               FontSize="{DynamicResource Text.Sm}" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="• Sales &amp; Financial Shifts: Local branch is authoritative. Never overwritten by cloud." 
                               FontSize="{DynamicResource Text.Xs}" 
                               Foreground="{DynamicResource Brush.InkSubtle}" 
                               Margin="0,2,0,2" />
                    <TextBlock Text="• Drug Catalog &amp; Regulations: Cloud is authoritative. Local custom sell prices preserved." 
                               FontSize="{DynamicResource Text.Xs}" 
                               Foreground="{DynamicResource Brush.InkSubtle}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
