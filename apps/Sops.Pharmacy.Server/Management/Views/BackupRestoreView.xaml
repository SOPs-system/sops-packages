<UserControl x:Class="Sops.Pharmacy.Server.Management.Views.BackupRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="https://sops.dev/ui">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <TextBlock Text="Encrypted Backup &amp; Safe Restoration" 
                           FontSize="{DynamicResource Text.Xl}" 
                           FontWeight="Bold" 
                           Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock Text="Authenticated point-in-time SQLCipher backups with SHA-256 validation and staged restoration." 
                           FontSize="{DynamicResource Text.Sm}" 
                           Foreground="{DynamicResource Brush.InkSubtle}" 
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Content="Create Encrypted Backup" 
                           Variant="primary" 
                           Size="sm" 
                           Margin="0,0,8,0" 
                           Click="OnCreateBackupClicked" />
                <ui:Button Content="Refresh List" 
                           Variant="secondary" 
                           Size="sm" 
                           Click="OnRefreshClicked" />
            </StackPanel>
        </Grid>

        <!-- Staged Restore Preflight Card -->
        <Border Grid.Row="1" 
                Background="{DynamicResource Brush.Surface}" 
                BorderBrush="{DynamicResource Brush.Line}" 
                BorderThickness="1" 
                CornerRadius="{DynamicResource Radius.Md}" 
                Padding="16" 
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Safe Restore Preflight &amp; Staging Architecture" 
                           FontSize="{DynamicResource Text.Base}" 
                           FontWeight="SemiBold" 
                           Foreground="{DynamicResource Brush.Ink}" />
                <TextBlock Text="Restores are unpacked to an isolated staging directory first, cryptographically verified against the pharmacy key, and checked for schema compatibility before replacing the active database." 
                           FontSize="{DynamicResource Text.Sm}" 
                           Foreground="{DynamicResource Brush.InkSubtle}" 
                           TextWrapping="Wrap" 
                           Margin="0,4,0,12" />
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Run Restore Preflight Check on Selected" 
                               Variant="secondary" 
                               Size="sm" 
                               Click="OnPreflightClicked" />
                    <TextBlock x:Name="TxtPreflightStatus" 
                               FontSize="{DynamicResource Text.Xs}" 
                               FontFamily="{DynamicResource Font.Mono}" 
                               Foreground="{DynamicResource Brush.InkMuted}" 
                               VerticalAlignment="Center" 
                               Margin="12,0,0,0" 
                               Text="Select a backup file below to run preflight inspection." />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Backups List -->
        <Border Grid.Row="2" 
                Background="{DynamicResource Brush.Surface}" 
                BorderBrush="{DynamicResource Brush.Line}" 
                BorderThickness="1" 
                CornerRadius="{DynamicResource Radius.Md}">
            <ListView x:Name="LstBackups" 
                      BorderThickness="0" 
                      Background="Transparent" 
                      Foreground="{DynamicResource Brush.Ink}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Backup File" Width="320" DisplayMemberBinding="{Binding FileName}" />
                        <GridViewColumn Header="Size (Bytes)" Width="120" DisplayMemberBinding="{Binding SizeBytes, StringFormat='{}{0:N0}'}" />
                        <GridViewColumn Header="Created (UTC)" Width="200" DisplayMemberBinding="{Binding CreatedAt, StringFormat='{}{0:yyyy-MM-dd HH:mm:ss}'}" />
                        <GridViewColumn Header="Full Disk Path" Width="420" DisplayMemberBinding="{Binding FullPath}" />
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
    </Grid>
</UserControl>
