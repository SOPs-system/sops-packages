<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="local-artifacts" value="artifacts" />
    <add key="github-sops" value="https://nuget.pkg.github.com/SOPs-system/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="local-artifacts">
      <package pattern="Sops.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <packageSource key="github-sops">
      <package pattern="Sops.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
