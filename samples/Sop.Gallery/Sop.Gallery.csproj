<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The canonical SOPs dev gallery: every primitive in every variant, with dark and RTL
    toggles. A primitive is done when it reads correctly here in all three.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <RootNamespace>Sop.Gallery</RootNamespace>
    <AssemblyName>Sop.Gallery</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>Sop.Gallery.App</StartupObject>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sop.Ui\Sop.Ui.csproj" />
    <Reference Include="System.Drawing" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" PrivateAssets="all" />
    <PackageReference Include="System.ValueTuple" />
  </ItemGroup>

</Project>
