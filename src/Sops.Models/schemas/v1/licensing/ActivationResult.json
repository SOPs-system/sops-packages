{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sops.org/schemas/v1/licensing/ActivationResult.json",
  "title": "ActivationResult",
  "description": "Outcome of device activation attempt.",
  "type": "object",
  "required": [
    "is_successful",
    "status"
  ],
  "properties": {
    "is_successful": {
      "type": "boolean"
    },
    "status": {
      "type": "string"
    },
    "certificate_raw": {
      "type": [
        "string",
        "null"
      ]
    },
    "failure_reason": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
