{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sops.org/schemas/v1/catalog/Distributor.json",
  "title": "Distributor",
  "description": "Pharmaceutical wholesaler or manufacturing supplier.",
  "type": "object",
  "required": [
    "id",
    "name",
    "phone"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tax_number": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "phone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "email": {
      "type": [
        "string",
        "null"
      ],
      "format": "email"
    },
    "address": {
      "$ref": "../common/Address.json"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "additionalProperties": false
}
