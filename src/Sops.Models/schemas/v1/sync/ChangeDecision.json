{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sops.org/schemas/v1/sync/ChangeDecision.json",
  "title": "ChangeDecision",
  "description": "Approval decision outcome for a sensitive operation.",
  "type": "object",
  "required": [
    "decision",
    "decided_by_user_id",
    "decided_at_utc"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "Approved",
        "Rejected"
      ]
    },
    "decided_by_user_id": {
      "type": "string",
      "format": "uuid"
    },
    "decided_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
