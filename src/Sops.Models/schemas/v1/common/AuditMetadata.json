{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sops.org/schemas/v1/common/AuditMetadata.json",
  "title": "AuditMetadata",
  "description": "Standard tracking and concurrency metadata for persistent records.",
  "type": "object",
  "required": [
    "created_at_utc",
    "version"
  ],
  "properties": {
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "created_by_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "updated_at_utc": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "updated_by_user_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": false
}
