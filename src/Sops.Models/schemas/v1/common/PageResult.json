{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sops.org/schemas/v1/common/PageResult.json",
  "title": "PageResult",
  "description": "Paginated envelope container for query results.",
  "type": "object",
  "required": [
    "page_number",
    "page_size",
    "total_count",
    "total_pages",
    "items"
  ],
  "properties": {
    "page_number": {
      "type": "integer",
      "minimum": 1
    },
    "page_size": {
      "type": "integer",
      "minimum": 1
    },
    "total_count": {
      "type": "integer",
      "minimum": 0
    },
    "total_pages": {
      "type": "integer",
      "minimum": 0
    },
    "items": {
      "type": "array"
    }
  },
  "additionalProperties": false
}
