{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sops.org/schemas/v1/tenancy/Chain.json",
  "title": "Chain",
  "description": "Multi-tenant organizational group representing a pharmacy chain or business.",
  "type": "object",
  "required": [
    "id",
    "name",
    "tax_number",
    "subscription_tier",
    "provision_status",
    "created_at_utc"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "tax_number": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "commercial_registration": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "subscription_tier": {
      "type": "string",
      "enum": [
        "Free",
        "Professional",
        "Enterprise",
        "Custom"
      ],
      "default": "Professional"
    },
    "provision_status": {
      "type": "string",
      "enum": [
        "Pending",
        "Active",
        "Suspended",
        "Decommissioned"
      ],
      "default": "Active"
    },
    "created_at_utc": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
