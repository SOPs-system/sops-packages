<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <ui:ScrollBarArrowLengthConverter x:Key="Sop.ScrollBar.ArrowLengthConverter" />
    <ui:ScrollBarArrowGlyphSizeConverter x:Key="Sop.ScrollBar.ArrowGlyphSizeConverter" />
    <ui:ScrollBarArrowStrokeConverter x:Key="Sop.ScrollBar.ArrowStrokeConverter" />

    <!-- ========== Scrollbars ==========
         A scrollbar is app chrome, so it follows the theme rather than the OS.
         A 12px-14px default gutter with a transparent track; the thumb is a pill inset by
         3px so it floats instead of filling the edge.
         Includes top/bottom (and left/right) arrow buttons for precision scrolling.
         Resizing is supported via ScrollBar.Width/Height or attached properties:
         ui:ScrollBarAssist.GutterSize, ui:ScrollBarAssist.ArrowSize, ui:ScrollBarAssist.ArrowGlyphSize.
         Merged into Application resources by Theme.Initialize. -->

    <Style x:Key="Sop.ScrollBar.Thumb" TargetType="{x:Type Thumb}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="Pill"
                            Margin="{DynamicResource Pad.ScrollbarInset}"
                            Background="{DynamicResource Brush.ScrollbarThumb}"
                            CornerRadius="{DynamicResource Radius.ScrollbarThumb}" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.ScrollbarThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Brush.ScrollbarThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The page-up/page-down halves of the track: invisible, still clickable. -->
    <Style x:Key="Sop.ScrollBar.Page" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Rectangle Fill="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Scroll Arrow Buttons (Top/Bottom/Left/Right) -->
    <Style x:Key="Sop.ScrollBar.ArrowButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="ButtonRoot"
                            Background="Transparent"
                            CornerRadius="{DynamicResource Radius.Full}">
                        <Path x:Name="ArrowGlyph"
                              Data="{TemplateBinding Tag}"
                              Stretch="Uniform"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Stroke="{DynamicResource Brush.ScrollbarThumb}"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              StrokeLineJoin="Round">
                            <Path.Width>
                                <MultiBinding Converter="{StaticResource Sop.ScrollBar.ArrowGlyphSizeConverter}">
                                    <Binding Path="(ui:ScrollBarAssist.ArrowGlyphSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Path.Width>
                            <Path.Height>
                                <MultiBinding Converter="{StaticResource Sop.ScrollBar.ArrowGlyphSizeConverter}">
                                    <Binding Path="(ui:ScrollBarAssist.ArrowGlyphSize)" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Path.Height>
                            <Path.StrokeThickness>
                                <MultiBinding Converter="{StaticResource Sop.ScrollBar.ArrowStrokeConverter}">
                                    <Binding Path="(ui:ScrollBarAssist.ArrowStrokeThickness)" RelativeSource="{RelativeSource TemplatedParent}" />
                                    <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                </MultiBinding>
                            </Path.StrokeThickness>
                        </Path>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
                            <Setter TargetName="ArrowGlyph" Property="Stroke" Value="{DynamicResource Brush.ScrollbarThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="ButtonRoot" Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
                            <Setter TargetName="ArrowGlyph" Property="Stroke" Value="{DynamicResource Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ArrowGlyph" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ScrollBar}">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="{DynamicResource Size.ScrollbarGutter}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ScrollBar}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Full}"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Top Arrow Button (LineUp) -->
                            <RepeatButton Grid.Row="0"
                                          Style="{StaticResource Sop.ScrollBar.ArrowButton}"
                                          Command="{x:Static ScrollBar.LineUpCommand}"
                                          Tag="{DynamicResource Icon.ChevronUp}">
                                <RepeatButton.Height>
                                    <MultiBinding Converter="{StaticResource Sop.ScrollBar.ArrowLengthConverter}">
                                        <Binding Path="(ui:ScrollBarAssist.ArrowSize)" RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ScrollBar}" />
                                    </MultiBinding>
                                </RepeatButton.Height>
                            </RepeatButton>

                            <!-- Track & Thumb -->
                            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Sop.ScrollBar.Page}" Command="{x:Static ScrollBar.PageUpCommand}" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource Sop.ScrollBar.Thumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Style="{StaticResource Sop.ScrollBar.Page}" Command="{x:Static ScrollBar.PageDownCommand}" />
                                </Track.IncreaseRepeatButton>
                            </Track>

                            <!-- Bottom Arrow Button (LineDown) -->
                            <RepeatButton Grid.Row="2"
                                          Style="{StaticResource Sop.ScrollBar.ArrowButton}"
                                          Command="{x:Static ScrollBar.LineDownCommand}"
                                          Tag="{DynamicResource Icon.ChevronDown}">
                                <RepeatButton.Height>
                                    <MultiBinding Converter="{StaticResource Sop.ScrollBar.ArrowLengthConverter}">
                                        <Binding Path="(ui:ScrollBarAssist.ArrowSize)" RelativeSource="{RelativeSource Self}" />
                                        <Binding Path="ActualWidth" RelativeSource="{RelativeSource AncestorType=ScrollBar}" />
                                    </MultiBinding>
                                </RepeatButton.Height>
                            </RepeatButton>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="{DynamicResource Size.ScrollbarGutter}" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ScrollBar}">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource Radius.Full}"
                                    ClipToBounds="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Left Arrow Button (LineLeft) -->
                                    <RepeatButton Grid.Column="0"
                                                  Style="{StaticResource Sop.ScrollBar.ArrowButton}"
                                                  Command="{x:Static ScrollBar.LineLeftCommand}"
                                                  Tag="{DynamicResource Icon.ChevronLeft}">
                                        <RepeatButton.Width>
                                            <MultiBinding Converter="{StaticResource Sop.ScrollBar.ArrowLengthConverter}">
                                                <Binding Path="(ui:ScrollBarAssist.ArrowSize)" RelativeSource="{RelativeSource Self}" />
                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=ScrollBar}" />
                                            </MultiBinding>
                                        </RepeatButton.Width>
                                    </RepeatButton>

                                    <!-- Track & Thumb -->
                                    <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource Sop.ScrollBar.Page}" Command="{x:Static ScrollBar.PageLeftCommand}" />
                                        </Track.DecreaseRepeatButton>
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource Sop.ScrollBar.Thumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Style="{StaticResource Sop.ScrollBar.Page}" Command="{x:Static ScrollBar.PageRightCommand}" />
                                        </Track.IncreaseRepeatButton>
                                    </Track>

                                    <!-- Right Arrow Button (LineRight) -->
                                    <RepeatButton Grid.Column="2"
                                                  Style="{StaticResource Sop.ScrollBar.ArrowButton}"
                                                  Command="{x:Static ScrollBar.LineRightCommand}"
                                                  Tag="{DynamicResource Icon.ChevronRight}">
                                        <RepeatButton.Width>
                                            <MultiBinding Converter="{StaticResource Sop.ScrollBar.ArrowLengthConverter}">
                                                <Binding Path="(ui:ScrollBarAssist.ArrowSize)" RelativeSource="{RelativeSource Self}" />
                                                <Binding Path="ActualHeight" RelativeSource="{RelativeSource AncestorType=ScrollBar}" />
                                            </MultiBinding>
                                        </RepeatButton.Width>
                                    </RepeatButton>
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
