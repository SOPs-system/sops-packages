<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Keyed styles the whole app reaches by name. A theme dictionary
         (Generic.xaml) is searched only for implicit type keys, so anything a
         screen names explicitly lives here and is merged into
         Application.Resources by Theme.Initialize. -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Sop.Ui;component/Controls/Calendar.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The drag-to-resize affordance: a thin bar centred inside a wider,
         invisible hit band that tints on hover and stays tinted while dragging.
         Shared by the table's column handles and the detail panel's edge. -->
    <Style x:Key="Sop.Gripper" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="{DynamicResource Size.ResizeBand}" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="22.5*" />
                            <RowDefinition Height="55*" />
                            <RowDefinition Height="22.5*" />
                        </Grid.RowDefinitions>
                        <!-- Hover tint fades; the drag tint is immediate and holds while
                             the pointer is off the band mid-drag. -->
                        <Rectangle x:Name="Band" Grid.RowSpan="3" Fill="{DynamicResource Brush.PrimarySoft}" Opacity="0" />
                        <Rectangle x:Name="DragBand" Grid.RowSpan="3" Fill="{DynamicResource Brush.PrimarySoft}" Opacity="0" />
                        <Rectangle x:Name="Bar"
                                   Grid.Row="1"
                                   Width="{DynamicResource Size.ResizeBar}"
                                   RadiusX="1"
                                   RadiusY="1"
                                   Fill="{DynamicResource Brush.LineStrong}"
                                   HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Brush.Primary}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Band" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Band" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="DragBand" Property="Opacity" Value="1" />
                            <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Brush.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The table's column handle: the shared gripper pulled half its width
         to the start so it straddles the column edge. -->
    <Style x:Key="Sop.Table.Gripper" TargetType="{x:Type Thumb}" BasedOn="{StaticResource Sop.Gripper}">
        <Setter Property="Margin" Value="-8,0,0,0" />
    </Style>

    <!-- Status indicator dot matching HTML .state-row dot with exact 8px (Space.2) trailing gap -->
    <Style x:Key="Sop.IndicatorDot" TargetType="{x:Type Ellipse}">
        <Setter Property="Width" Value="{DynamicResource Size.ToastDot}" />
        <Setter Property="Height" Value="{DynamicResource Size.ToastDot}" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- State row container matching HTML .state-row flexbox layout (gap handled by indicator margin) -->
    <Style x:Key="Sop.StateRow" TargetType="{x:Type StackPanel}">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
