    <!-- Stroke icons. Two sets:

         1. The glyphs the primitives draw in their own templates (close,
            check, chevron) — small, drawn with Stroke="{Binding Foreground}"
            StrokeThickness="2" inside a Viewbox sized by Size.Icon*.
            Asymmetric glyphs (Check) are pinned to FlowDirection="LeftToRight"
            so RTL does not mirror them.

         2. The app icon set, `Icon.<Name>`: the lucide-style 24×24 outlines of
            the web app's app/icons.tsx, path data verbatim — WPF's path
            mini-language is a superset of the SVG `d` syntax. Draw them with
            <ui:Icon Glyph="Bell" Size="17" />, which scales the 2px stroke
            with the box the way an SVG viewBox does. -->

    <!-- ===== template glyphs ===== -->
    <!-- 14×14 -->
    <Geometry x:Key="Icon.Close">M1,1 L13,13 M13,1 L1,13</Geometry>
    <!-- 12×10 -->
    <!-- Every glyph is drawn on the same 24×24 canvas. This one was written
         against a 12×12 box, so it rendered half-size in the top-left corner
         of its slot — the tick beside "Complete sale" sat above its label. -->
    <Geometry x:Key="Icon.Check">M20 6 9 17l-5-5</Geometry>
    <!-- 12×8 -->
    <Geometry x:Key="Icon.Chevron">M1,1 L6,6 L11,1</Geometry>

