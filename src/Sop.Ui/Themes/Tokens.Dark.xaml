<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         DARK palette — mirrors [data-theme='dark'] in src/ui/theme.css.
         Only semantic aliases change; the key set must equal
         Tokens.Light.xaml exactly (a test enforces it).
         SOP dark: brand-secondary (teal-500) becomes primary.
         ============================================================ -->

    <Color x:Key="Color.Teal50">#E4F1F1</Color>
    <Color x:Key="Color.Teal100">#C9E3E3</Color>
    <Color x:Key="Color.Teal500">#0F7C7E</Color>
    <Color x:Key="Color.Teal600">#0A6C6E</Color>
    <Color x:Key="Color.Teal700">#085658</Color>
    <Color x:Key="Color.Teal800">#064143</Color>

    <Color x:Key="Color.Bg">#0B1114</Color>
    <Color x:Key="Color.Surface">#10181C</Color>
    <Color x:Key="Color.SurfaceRaised">#162126</Color>
    <Color x:Key="Color.SurfaceSunken">#1A242B</Color>
    <Color x:Key="Color.Overlay">#9904080A</Color>
    <Color x:Key="Color.Line">#2A3842</Color>
    <Color x:Key="Color.LineSubtle">#1F2B33</Color>
    <Color x:Key="Color.LineStrong">#3E4F5B</Color>
    <Color x:Key="Color.ScrollbarThumb">#3E4F5B</Color>
    <Color x:Key="Color.ScrollbarThumbHover">#5A6E7D</Color>

    <Color x:Key="Color.Ink">#F8FAFC</Color>
    <Color x:Key="Color.InkMuted">#CBD5E1</Color>
    <Color x:Key="Color.InkSubtle">#94A3B8</Color>
    <Color x:Key="Color.InkInverse">#0F172A</Color>

    <Color x:Key="Color.Primary">#0F7C7E</Color>
    <Color x:Key="Color.PrimaryHover">#139496</Color>
    <Color x:Key="Color.PrimaryActive">#17A9AB</Color>
    <Color x:Key="Color.PrimarySoft">#0F2A2B</Color>
    <Color x:Key="Color.PrimarySoftHover">#B30F2A2B</Color>
    <Color x:Key="Color.PrimarySoftBorder">#1A4344</Color>
    <Color x:Key="Color.OnPrimary">#FFFFFF</Color>

    <Color x:Key="Color.Success">#2A9D99</Color>
    <Color x:Key="Color.SuccessHover">#238A86</Color>
    <Color x:Key="Color.SuccessSoft">#0F2A29</Color>
    <Color x:Key="Color.SuccessSoftText">#3FB3AE</Color>
    <Color x:Key="Color.SuccessLine">#4D2A9D99</Color>
    <Color x:Key="Color.SuccessLineStrong">#662A9D99</Color>

    <Color x:Key="Color.Warning">#DD5B00</Color>
    <Color x:Key="Color.WarningHover">#C05000</Color>
    <Color x:Key="Color.WarningSoft">#2A1A0E</Color>
    <Color x:Key="Color.WarningSoftHover">#B32A1A0E</Color>
    <Color x:Key="Color.WarningSoftText">#F0812E</Color>
    <Color x:Key="Color.WarningLine">#4DDD5B00</Color>
    <Color x:Key="Color.WarningLineStrong">#66DD5B00</Color>

    <Color x:Key="Color.Danger">#DC2626</Color>
    <Color x:Key="Color.DangerHover">#B91C1C</Color>
    <Color x:Key="Color.DangerSoft">#2A1010</Color>
    <Color x:Key="Color.DangerSoftHover">#B32A1010</Color>
    <Color x:Key="Color.DangerSoftText">#EF6A6A</Color>
    <Color x:Key="Color.DangerLine">#4DDC2626</Color>
    <Color x:Key="Color.DangerLineStrong">#66DC2626</Color>

    <Color x:Key="Color.Info">#355E9A</Color>
    <Color x:Key="Color.InfoSoft">#14213A</Color>
    <Color x:Key="Color.InfoSoftText">#7BA1D8</Color>
    <Color x:Key="Color.InfoLine">#4D355E9A</Color>
    <Color x:Key="Color.InfoLineStrong">#66355E9A</Color>

    <Color x:Key="Color.FocusRing">#730F7C7E</Color>
    <Color x:Key="Color.Shadow">#000000</Color>

    <Color x:Key="Color.PrintInk">#000000</Color>
    <Color x:Key="Color.PrintPaper">#FFFFFF</Color>

    <SolidColorBrush x:Key="Brush.Bg" Color="{StaticResource Color.Bg}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.SurfaceSunken" Color="{StaticResource Color.SurfaceSunken}" />
    <SolidColorBrush x:Key="Brush.Overlay" Color="{StaticResource Color.Overlay}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.LineSubtle" Color="{StaticResource Color.LineSubtle}" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource Color.LineStrong}" />
    <SolidColorBrush x:Key="Brush.ScrollbarThumb" Color="{StaticResource Color.ScrollbarThumb}" />
    <SolidColorBrush x:Key="Brush.ScrollbarThumbHover" Color="{StaticResource Color.ScrollbarThumbHover}" />

    <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
    <SolidColorBrush x:Key="Brush.InkMuted" Color="{StaticResource Color.InkMuted}" />
    <SolidColorBrush x:Key="Brush.InkSubtle" Color="{StaticResource Color.InkSubtle}" />
    <SolidColorBrush x:Key="Brush.InkInverse" Color="{StaticResource Color.InkInverse}" />

    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.PrimaryHover" Color="{StaticResource Color.PrimaryHover}" />
    <SolidColorBrush x:Key="Brush.PrimaryActive" Color="{StaticResource Color.PrimaryActive}" />
    <SolidColorBrush x:Key="Brush.PrimarySoft" Color="{StaticResource Color.PrimarySoft}" />
    <SolidColorBrush x:Key="Brush.PrimarySoftHover" Color="{StaticResource Color.PrimarySoftHover}" />
    <SolidColorBrush x:Key="Brush.PrimarySoftBorder" Color="{StaticResource Color.PrimarySoftBorder}" />
    <SolidColorBrush x:Key="Brush.OnPrimary" Color="{StaticResource Color.OnPrimary}" />

    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="{StaticResource Color.SuccessHover}" />
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="{StaticResource Color.SuccessSoft}" />
    <SolidColorBrush x:Key="Brush.SuccessSoftText" Color="{StaticResource Color.SuccessSoftText}" />
    <SolidColorBrush x:Key="Brush.SuccessLine" Color="{StaticResource Color.SuccessLine}" />
    <SolidColorBrush x:Key="Brush.SuccessLineStrong" Color="{StaticResource Color.SuccessLineStrong}" />

    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.WarningHover" Color="{StaticResource Color.WarningHover}" />
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="{StaticResource Color.WarningSoft}" />
    <SolidColorBrush x:Key="Brush.WarningSoftHover" Color="{StaticResource Color.WarningSoftHover}" />
    <SolidColorBrush x:Key="Brush.WarningSoftText" Color="{StaticResource Color.WarningSoftText}" />
    <SolidColorBrush x:Key="Brush.WarningLine" Color="{StaticResource Color.WarningLine}" />
    <SolidColorBrush x:Key="Brush.WarningLineStrong" Color="{StaticResource Color.WarningLineStrong}" />

    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.DangerHover" Color="{StaticResource Color.DangerHover}" />
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="{StaticResource Color.DangerSoft}" />
    <SolidColorBrush x:Key="Brush.DangerSoftHover" Color="{StaticResource Color.DangerSoftHover}" />
    <SolidColorBrush x:Key="Brush.DangerSoftText" Color="{StaticResource Color.DangerSoftText}" />
    <SolidColorBrush x:Key="Brush.DangerLine" Color="{StaticResource Color.DangerLine}" />
    <SolidColorBrush x:Key="Brush.DangerLineStrong" Color="{StaticResource Color.DangerLineStrong}" />

    <SolidColorBrush x:Key="Brush.Info" Color="{StaticResource Color.Info}" />
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="{StaticResource Color.InfoSoft}" />
    <SolidColorBrush x:Key="Brush.InfoSoftText" Color="{StaticResource Color.InfoSoftText}" />
    <SolidColorBrush x:Key="Brush.InfoLine" Color="{StaticResource Color.InfoLine}" />
    <SolidColorBrush x:Key="Brush.InfoLineStrong" Color="{StaticResource Color.InfoLineStrong}" />

    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />
    <SolidColorBrush x:Key="Brush.PrintInk" Color="{StaticResource Color.PrintInk}" />
    <SolidColorBrush x:Key="Brush.PrintPaper" Color="{StaticResource Color.PrintPaper}" />

    <DropShadowEffect x:Key="Shadow.CardXs" Color="{StaticResource Color.Shadow}" BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.25" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Shadow.Card" Color="{StaticResource Color.Shadow}" BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.4" RenderingBias="Performance" />
    <DropShadowEffect x:Key="Shadow.Deep" Color="{StaticResource Color.Shadow}" BlurRadius="22" ShadowDepth="8" Direction="270" Opacity="0.50" RenderingBias="Performance" />

</ResourceDictionary>
