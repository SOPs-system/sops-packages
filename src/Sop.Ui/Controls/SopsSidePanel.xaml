<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <Style TargetType="{x:Type ui:SopsSidePanel}">
        <Setter Property="Width" Value="{DynamicResource Size.Panel}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:SopsSidePanel}">
                    <Border x:Name="RootBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <DockPanel>
                                <!-- Header Row -->
                                <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1" Padding="16,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="{TemplateBinding Title}" FontWeight="Bold" FontSize="{DynamicResource Text.Sm}" />
                                            <Border x:Name="BadgeBorder" Padding="6,1" Margin="8,0,0,0" CornerRadius="{DynamicResource Radius.Full}"
                                                    Background="{DynamicResource Brush.DangerSoft}" VerticalAlignment="Center"
                                                    Visibility="{Binding Badge, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:PresentToVisibilityConverter.Instance}}">
                                                <TextBlock Text="{TemplateBinding Badge}" FontSize="{DynamicResource Text.2Xs}" FontWeight="Bold"
                                                           Foreground="{DynamicResource Brush.DangerSoftText}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Close Button -->
                                        <ui:IconButton x:Name="PART_CloseButton" Grid.Column="1" Size="Sm">
                                            <ui:Icon Glyph="Close" Size="14" Foreground="{DynamicResource Brush.InkSubtle}" />
                                        </ui:IconButton>
                                    </Grid>
                                </Border>

                                <!-- Optional Header Slot -->
                                <ContentPresenter DockPanel.Dock="Top" ContentSource="Header" />

                                <!-- Main Content Area -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ContentPresenter />
                                </ScrollViewer>
                            </DockPanel>

                            <!-- Interactive Resizing Grip Handle on leading edge -->
                            <Thumb x:Name="PART_ResizeGrip"
                                   Width="8"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Stretch"
                                   Cursor="SizeWE"
                                   Margin="-4,0,0,0">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="{x:Type Thumb}">
                                        <Border Background="Transparent" Width="8">
                                            <Rectangle x:Name="GripIndicator" Width="2" HorizontalAlignment="Center" Fill="Transparent" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="GripIndicator" Property="Fill" Value="{DynamicResource Brush.Primary}" />
                                            </Trigger>
                                            <Trigger Property="IsDragging" Value="True">
                                                <Setter TargetName="GripIndicator" Property="Fill" Value="{DynamicResource Brush.Primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsResizable" Value="False">
                            <Setter TargetName="PART_ResizeGrip" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="False">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>