<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <Style x:Key="SyncStatus.ActionButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Xs}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.LineSubtle}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Line}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ui:SyncStatus}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:SyncStatus}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Padding="{TemplateBinding Padding}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- State indicator dot/icon -->
                            <Border x:Name="StateDot" Grid.Column="0"
                                    Width="8" Height="8"
                                    CornerRadius="{DynamicResource Radius.Full}"
                                    Background="{DynamicResource Brush.Success}"
                                    Margin="0,0,8,0" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="TitleText"
                                               Text="All changes saved"
                                               Foreground="{DynamicResource Brush.Ink}"
                                               FontSize="{DynamicResource Text.Sm}"
                                               FontWeight="Medium" />
                                    <TextBlock x:Name="PendingBadge"
                                               Text="{Binding PendingCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat='({0} pending)'}"
                                               Foreground="{DynamicResource Brush.Warning}"
                                               FontSize="{DynamicResource Text.Xs}"
                                               FontWeight="SemiBold"
                                               Margin="6,0,0,0"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="ConflictBadge"
                                               Text="{Binding ConflictCount, RelativeSource={RelativeSource TemplatedParent}, StringFormat='({0} conflicts)'}"
                                               Foreground="{DynamicResource Brush.Danger}"
                                               FontSize="{DynamicResource Text.Xs}"
                                               FontWeight="Bold"
                                               Margin="6,0,0,0"
                                               Visibility="Collapsed"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock x:Name="SubtitleText"
                                           Text="{Binding LastSyncedText, RelativeSource={RelativeSource TemplatedParent}, StringFormat='Last synced: {0}'}"
                                           Foreground="{DynamicResource Brush.InkMuted}"
                                           FontSize="{DynamicResource Text.Xs}"
                                           Margin="0,2,0,0" />
                            </StackPanel>

                            <!-- Action button (Sync Now or Review) -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="12,0,0,0"
                                        Visibility="{Binding ShowAction, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:BooleanToVisibilityConverter.Instance}}">
                                <Button x:Name="SyncButton"
                                        Tag="SYNC_NOW"
                                        Style="{StaticResource SyncStatus.ActionButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Icon Glyph="RotateCcw" Size="12" Foreground="{DynamicResource Brush.InkSubtle}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Sync now" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button x:Name="ReviewButton"
                                        Tag="REVIEW_CONFLICTS"
                                        Style="{StaticResource SyncStatus.ActionButton}"
                                        Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:Icon Glyph="AlertTriangle" Size="12" Foreground="{DynamicResource Brush.Danger}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Review conflicts" Foreground="{DynamicResource Brush.Danger}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Syncing State -->
                        <Trigger Property="State" Value="Syncing">
                            <Setter TargetName="StateDot" Property="Background" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="TitleText" Property="Text" Value="Syncing data..." />
                        </Trigger>

                        <!-- Pending State -->
                        <Trigger Property="State" Value="Pending">
                            <Setter TargetName="StateDot" Property="Background" Value="{DynamicResource Brush.Warning}" />
                            <Setter TargetName="TitleText" Property="Text" Value="Unsynced changes" />
                            <Setter TargetName="PendingBadge" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!-- Offline State -->
                        <Trigger Property="State" Value="Offline">
                            <Setter TargetName="StateDot" Property="Background" Value="{DynamicResource Brush.InkMuted}" />
                            <Setter TargetName="TitleText" Property="Text" Value="Working offline" />
                        </Trigger>

                        <!-- Conflict State -->
                        <Trigger Property="State" Value="Conflict">
                            <Setter TargetName="StateDot" Property="Background" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="TitleText" Property="Text" Value="Sync conflict detected" />
                            <Setter TargetName="ConflictBadge" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SyncButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ReviewButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
