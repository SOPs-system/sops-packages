<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- ==================== Day Button ==================== -->
    <Style x:Key="Sop.CalendarDayButton" TargetType="CalendarDayButton">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Xs}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarDayButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fill"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Background="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Hover -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.LineSubtle}" />
                        </Trigger>
                        <!-- Inactive / Out of Month -->
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <!-- Today -->
                        <Trigger Property="IsToday" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter TargetName="Fill" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="Fill" Property="BorderThickness" Value="1" />
                        </Trigger>
                        <!-- Highlighted -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                        </Trigger>
                        <!-- Selected -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- Selected + Hover -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.PrimaryHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
                        </MultiTrigger>
                        <!-- In Range Middle (CalendarAssist) -->
                        <Trigger Property="ui:CalendarAssist.IsRangeMiddle" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <!-- In Range Middle + Hover -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ui:CalendarAssist.IsRangeMiddle" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.PrimarySoftHover}" />
                        </MultiTrigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Month / Year Button ==================== -->
    <Style x:Key="Sop.CalendarButton" TargetType="CalendarButton">
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Fill"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Background="Transparent" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.LineSubtle}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Fill" Property="Background" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header Navigation Button Style -->
    <Style x:Key="Sop.CalendarNavButton" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Sm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.LineSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== CalendarItem ==================== -->
    <Style x:Key="Sop.CalendarItem" TargetType="CalendarItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CalendarItem">
                    <ControlTemplate.Resources>
                        <!-- Day header template: Sun, Mon, etc. -->
                        <DataTemplate x:Key="DayTitleTemplate">
                            <TextBlock Text="{Binding}"
                                       Foreground="{DynamicResource Brush.InkMuted}"
                                       FontSize="{DynamicResource Text.2Xs}"
                                       FontWeight="Medium"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,4,0,8" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root" Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Header bar: Previous, Month/Year Title, Next -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button x:Name="PART_PreviousButton"
                                    Grid.Column="0"
                                    Style="{StaticResource Sop.CalendarNavButton}">
                                <Path Data="M 6 0 L 0 5 L 6 10"
                                      Stroke="{DynamicResource Brush.InkMuted}"
                                      StrokeThickness="1.5"
                                      SnapsToDevicePixels="True" />
                            </Button>

                            <Button x:Name="PART_HeaderButton"
                                    Grid.Column="1"
                                    FontWeight="SemiBold"
                                    FontSize="{DynamicResource Text.Sm}"
                                    Foreground="{DynamicResource Brush.Ink}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    FocusVisualStyle="{x:Null}"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Padding="8,4" />

                            <Button x:Name="PART_NextButton"
                                    Grid.Column="2"
                                    Style="{StaticResource Sop.CalendarNavButton}">
                                <Path Data="M 0 0 L 6 5 L 0 10"
                                      Stroke="{DynamicResource Brush.InkMuted}"
                                      StrokeThickness="1.5"
                                      SnapsToDevicePixels="True" />
                            </Button>
                        </Grid>

                        <!-- Days of Month Grid -->
                        <Grid x:Name="PART_MonthView"
                              Grid.Row="1"
                              Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>

                        <!-- Year / Decade View Grid -->
                        <Grid x:Name="PART_YearView"
                              Grid.Row="1"
                              Visibility="Hidden">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ==================== Standalone Calendar Style ==================== -->
    <Style TargetType="{x:Type Calendar}">
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource Sop.CalendarDayButton}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource Sop.CalendarButton}" />
        <Setter Property="CalendarItemStyle" Value="{StaticResource Sop.CalendarItem}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Padding="8">
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Style="{TemplateBinding CalendarItemStyle}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Popup Calendar Style (used inside DateInput / DatePicker dropdown) -->
    <Style x:Key="Calendar.Popup" TargetType="{x:Type Calendar}" BasedOn="{StaticResource {x:Type Calendar}}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
        <Setter Property="Effect" Value="{DynamicResource Shadow.Deep}" />
    </Style>

</ResourceDictionary>
