<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls"
    xmlns:root="clr-namespace:Sop.Ui">

    <!-- The form-control frame. Select's trigger is an Input, so a text box
         and a picker stay visually identical in a form row. -->
    <Style TargetType="{x:Type ui:Input}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="SelectionOpacity" Value="0.3" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="{DynamicResource Size.Hit}" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Input}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Input}">
                    <Grid>
                        <Border x:Name="Ring"
                                Margin="{DynamicResource Ring.Margin}"
                                BorderThickness="{DynamicResource Ring.Thickness}"
                                BorderBrush="{DynamicResource Brush.FocusRing}"
                                CornerRadius="{DynamicResource Radius.MdRing}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Prefix"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding Prefix}"
                                                  Margin="{DynamicResource Pad.Affix.Start}"
                                                  VerticalAlignment="Center"
                                                  TextBlock.Foreground="{DynamicResource Brush.InkSubtle}" />
                                <Grid Grid.Column="1">
                                    <TextBlock x:Name="Placeholder"
                                               Margin="{TemplateBinding Padding}"
                                               Text="{TemplateBinding Placeholder}"
                                               Foreground="{DynamicResource Brush.InkSubtle}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                    <!-- No Margin here on purpose. TextBoxBase
                                         insets the text by the TextBox's own
                                         Padding, inside the view, where no
                                         template can reach it. Adding the same
                                         Padding again as a margin inset the text
                                         TWICE while the placeholder beside it
                                         moved once — so the caret sat to the
                                         right of the placeholder and the text
                                         jumped sideways the moment you typed.
                                         Padding is now the one thing that
                                         positions both. -->
                                    <ScrollViewer x:Name="PART_ContentHost"
                                                  VerticalAlignment="Center"
                                                  HorizontalScrollBarVisibility="Hidden"
                                                  VerticalScrollBarVisibility="Hidden"
                                                  Focusable="False" />
                                </Grid>
                                <ContentPresenter x:Name="Suffix"
                                                  Grid.Column="2"
                                                  Content="{TemplateBinding Suffix}"
                                                  Margin="{DynamicResource Pad.Affix.End}"
                                                  VerticalAlignment="Center"
                                                  TextBlock.Foreground="{DynamicResource Brush.InkSubtle}" />
                            </Grid>
                        </Border>
                        <!-- The focused border fades in over the resting one. -->
                        <Border x:Name="FocusFrame"
                                BorderBrush="{DynamicResource Brush.Primary}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasPrefix" Value="False">
                            <Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasSuffix" Value="False">
                            <Setter TargetName="Suffix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <!-- Affixes carry their own gutter, so the text drops the
                             padding on that side. Set on Padding, not on the two
                             children's margins: Padding is what the framework
                             insets the text by, so moving it moves the caret and
                             the placeholder together. -->
                        <Trigger Property="HasPrefix" Value="True">
                            <Setter Property="Padding" Value="{DynamicResource Pad.InputAfterPrefix}" />
                        </Trigger>
                        <Trigger Property="HasSuffix" Value="True">
                            <Setter Property="Padding" Value="{DynamicResource Pad.InputBeforeSuffix}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasPrefix" Value="True" />
                                <Condition Property="HasSuffix" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter Property="Padding" Value="{DynamicResource Pad.None}" />
                        </MultiTrigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding (root:Theme.KeyboardMode), RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <!-- Listed after focus so a focused invalid field stays red:
                             the focus frame and ring are hidden outright. -->
                        <Trigger Property="ui:Field.IsInvalid" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="FocusFrame" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
                            <Setter Property="Opacity" Value="0.6" />
                            <Setter Property="Cursor" Value="No" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Size" Value="Sm">
                <Setter Property="Height" Value="{DynamicResource Size.HitSm}" />
                <Setter Property="Padding" Value="{DynamicResource Pad.InputSm}" />
            </Trigger>
            <Trigger Property="Size" Value="Lg">
                <Setter Property="Height" Value="{DynamicResource Size.HitLg}" />
                <Setter Property="Padding" Value="{DynamicResource Pad.InputLg}" />
                <Setter Property="FontSize" Value="{DynamicResource Text.Md}" />
            </Trigger>
            <!-- Tabular figures + end alignment for amounts. -->
            <Trigger Property="Numeric" Value="True">
                <Setter Property="TextAlignment" Value="Right" />
                <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
