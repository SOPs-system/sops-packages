<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- A placeholder block. The sunken surface is the same tone an empty
         well takes elsewhere, so a screen filling up reads as one surface
         resolving rather than as grey boxes laid over it. -->
    <Style TargetType="{x:Type ui:Skeleton}">
        <Setter Property="Height" Value="12" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Skeleton}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Sm}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
