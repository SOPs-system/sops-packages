<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- Keypad Button Style -->
    <Style x:Key="NumericKeypad.KeyButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="48" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Lg}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Md}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.LineSubtle}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Line}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NumericKeypad.ActionKeyButton" TargetType="{x:Type Button}" BasedOn="{StaticResource NumericKeypad.KeyButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <Style x:Key="NumericKeypad.EnterKeyButton" TargetType="{x:Type Button}" BasedOn="{StaticResource NumericKeypad.KeyButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Md}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Md}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryHover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.PrimaryActive}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ui:NumericKeypad}">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Width" Value="280" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:NumericKeypad}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Lg}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel FlowDirection="LeftToRight">
                            <!-- Quick Cash Denomination Buttons (+10, +20, +50, +100) -->
                            <Grid Margin="0,0,0,4" Visibility="{Binding ShowQuickCash, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:BooleanToVisibilityConverter.Instance}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="+10" Style="{StaticResource NumericKeypad.ActionKeyButton}" Tag="+10" Height="36" />
                                <Button Grid.Column="1" Content="+20" Style="{StaticResource NumericKeypad.ActionKeyButton}" Tag="+20" Height="36" />
                                <Button Grid.Column="2" Content="+50" Style="{StaticResource NumericKeypad.ActionKeyButton}" Tag="+50" Height="36" />
                                <Button Grid.Column="3" Content="+100" Style="{StaticResource NumericKeypad.ActionKeyButton}" Tag="+100" Height="36" />
                            </Grid>

                            <!-- Numeric Keypad Grid (4 columns x 4 rows) -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Row 1: 7, 8, 9, Backspace -->
                                <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource NumericKeypad.KeyButton}" Tag="7" />
                                <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource NumericKeypad.KeyButton}" Tag="8" />
                                <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource NumericKeypad.KeyButton}" Tag="9" />
                                <Button Grid.Row="0" Grid.Column="3" Content="⌫" Style="{StaticResource NumericKeypad.ActionKeyButton}" Tag="BACKSPACE" />

                                <!-- Row 2: 4, 5, 6, Clear -->
                                <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumericKeypad.KeyButton}" Tag="4" />
                                <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumericKeypad.KeyButton}" Tag="5" />
                                <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumericKeypad.KeyButton}" Tag="6" />
                                <Button Grid.Row="1" Grid.Column="3" Content="C" Style="{StaticResource NumericKeypad.ActionKeyButton}" Tag="CLEAR" />

                                <!-- Row 3: 1, 2, 3, Enter (RowSpan 2) -->
                                <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource NumericKeypad.KeyButton}" Tag="1" />
                                <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource NumericKeypad.KeyButton}" Tag="2" />
                                <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource NumericKeypad.KeyButton}" Tag="3" />
                                <Button Grid.Row="2" Grid.Column="3" Grid.RowSpan="2" Height="100" Content="↵" Style="{StaticResource NumericKeypad.EnterKeyButton}" Tag="ENTER" />

                                <!-- Row 4: 0, 00, . -->
                                <Button Grid.Row="3" Grid.Column="0" Content="0" Style="{StaticResource NumericKeypad.KeyButton}" Tag="0" />
                                <Button Grid.Row="3" Grid.Column="1" Content="00" Style="{StaticResource NumericKeypad.KeyButton}" Tag="00" />
                                <Button Grid.Row="3" Grid.Column="2" Content="." Style="{StaticResource NumericKeypad.KeyButton}" Tag="." />
                            </Grid>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
