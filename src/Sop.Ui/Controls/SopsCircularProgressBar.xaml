<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- ====================================================================
         SopsCircularProgressBar: Circular Capsule Segmented Progress Bar
         - Two circular arc segments (Completed & Remaining)
         - Fully rounded end-caps on all arc ends (PenLineCap.Round)
         - 4px angular gap between segments
         - Flat, minimal, theme token support
         - Optional centered percentage text
         ==================================================================== -->
    <Style TargetType="{x:Type ui:SopsCircularProgressBar}">
        <Setter Property="Width" Value="{Binding Diameter, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Height" Value="{Binding Diameter, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Diameter" Value="48" />
        <Setter Property="StrokeThickness" Value="6" />
        <Setter Property="SegmentGap" Value="4" />
        <Setter Property="CompletedBrush" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="RemainingBrush" Value="{DynamicResource Brush.SurfaceSunken}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:SopsCircularProgressBar}">
                    <Grid Width="{TemplateBinding Diameter}" Height="{TemplateBinding Diameter}">
                        <!-- Center Percentage Text (optional) -->
                        <TextBlock x:Name="PART_PercentageLabel"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   FontSize="{DynamicResource Text.Xs}"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource Brush.Ink}"
                                   Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPercentage" Value="True">
                            <Setter TargetName="PART_PercentageLabel" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
