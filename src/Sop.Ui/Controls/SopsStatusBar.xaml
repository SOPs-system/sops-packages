<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <Style TargetType="{x:Type ui:SopsStatusBar}">
        <Setter Property="Height" Value="{DynamicResource Size.StatusBar}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Xs}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:SopsStatusBar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="12,0">
                        <DockPanel VerticalAlignment="Center">
                            <!-- Left Group: Storage & Shift Info -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Storage Engine Chip -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ui:Icon Glyph="Database" Size="13" Foreground="{DynamicResource Brush.InkSubtle}" VerticalAlignment="Center" />
                                    <Ellipse x:Name="StorageDot" Width="{DynamicResource Size.Dot}" Height="{DynamicResource Size.Dot}"
                                             Margin="6,0,6,0" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding StorageEngine}" FontSize="{DynamicResource Text.Xs}"
                                               Foreground="{DynamicResource Brush.InkSubtle}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Divider -->
                                <Rectangle Width="1" Height="14" Margin="0,0,16,0" Fill="{DynamicResource Brush.LineSubtle}" />

                                <!-- Shift Button -->
                                <ui:Button x:Name="PART_ShiftButton" Variant="Ghost" Size="Sm" Height="26" Padding="6,0" CornerRadius="{DynamicResource Radius.Sm}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Icon Glyph="Clock" Size="13" Foreground="{DynamicResource Brush.InkSubtle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{TemplateBinding SessionDuration}" FontFamily="{DynamicResource Font.Mono}"
                                                   Typography.NumeralAlignment="Tabular" FontWeight="SemiBold"
                                                   Margin="6,0,6,0" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                                        <Ellipse Width="{DynamicResource Size.Dot}" Height="{DynamicResource Size.Dot}"
                                                 Fill="{DynamicResource Brush.Success}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{TemplateBinding ShiftName}" FontSize="{DynamicResource Text.Xs}"
                                                   Foreground="{DynamicResource Brush.InkMuted}" VerticalAlignment="Center" />
                                        <ui:Kbd Margin="6,0,0,0">F2</ui:Kbd>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>

                            <!-- Right Group: System Clock & Shortcuts -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <!-- System Clock -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <ui:Icon Glyph="Clock" Size="13" Foreground="{DynamicResource Brush.InkSubtle}" VerticalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding SystemClock}" FontFamily="{DynamicResource Font.Mono}"
                                               Typography.NumeralAlignment="Tabular" FontWeight="SemiBold"
                                               Margin="6,0,0,0" Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Divider -->
                                <Rectangle Width="1" Height="14" Margin="0,0,12,0" Fill="{DynamicResource Brush.LineSubtle}" />

                                <!-- Shortcuts Button -->
                                <ui:Button x:Name="PART_ShortcutsButton" Variant="Ghost" Size="Sm" Height="26" Padding="6,0" CornerRadius="{DynamicResource Radius.Sm}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Icon Glyph="Settings" Size="13" Foreground="{DynamicResource Brush.InkSubtle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{TemplateBinding ShortcutsHint}" Margin="6,0,6,0" FontSize="{DynamicResource Text.Xs}"
                                                   Foreground="{DynamicResource Brush.InkSubtle}" VerticalAlignment="Center" />
                                        <ui:Kbd>F1</ui:Kbd>
                                    </StackPanel>
                                </ui:Button>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsStorageConnected" Value="False">
                            <Setter TargetName="StorageDot" Property="Fill" Value="{DynamicResource Brush.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>