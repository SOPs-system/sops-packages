<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <Style TargetType="{x:Type ui:EmptyState}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="32,48" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:EmptyState}">
                    <Border Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            MaxWidth="440">
                        <StackPanel HorizontalAlignment="Center">
                            <!-- Circular Icon Frame -->
                            <Border Width="64"
                                    Height="64"
                                    Background="{DynamicResource Brush.SurfaceSunken}"
                                    BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Full}"
                                    HorizontalAlignment="Center"
                                    Margin="0,0,0,16">
                                <ui:Icon Glyph="{TemplateBinding IconGlyph}"
                                         Size="28"
                                         Foreground="{DynamicResource Brush.InkSubtle}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center" />
                            </Border>

                            <!-- Title -->
                            <TextBlock Text="{TemplateBinding Title}"
                                       Foreground="{DynamicResource Brush.Ink}"
                                       FontSize="{DynamicResource Text.Lg}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       Margin="0,0,0,8" />

                            <!-- Description -->
                            <TextBlock Text="{TemplateBinding Description}"
                                       Foreground="{DynamicResource Brush.InkSubtle}"
                                       FontSize="{DynamicResource Text.Sm}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       LineHeight="20"
                                       Margin="0,0,0,20"
                                       Visibility="{Binding Description, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:PresentToVisibilityConverter.Instance}}" />

                            <!-- Action Buttons -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <ui:Button x:Name="PART_ActionButton"
                                           Variant="Primary"
                                           Size="Md"
                                           Margin="0,0,8,0"
                                           Content="{TemplateBinding ActionText}"
                                           Visibility="{Binding ActionText, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:PresentToVisibilityConverter.Instance}}" />
                                <ui:Button x:Name="PART_SecondaryButton"
                                           Variant="Secondary"
                                           Size="Md"
                                           Content="{TemplateBinding SecondaryActionText}"
                                           Visibility="{Binding SecondaryActionText, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:PresentToVisibilityConverter.Instance}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
