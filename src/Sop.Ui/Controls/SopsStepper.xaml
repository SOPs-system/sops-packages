<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- Step indicator button/badge template -->
    <DataTemplate DataType="{x:Type ui:StepItem}">
        <Grid Margin="0,0,16,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Step Circle and Connecting Track -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Circle Indicator -->
                <Button x:Name="StepButton"
                        Width="28" Height="28"
                        Background="{DynamicResource Brush.SurfaceSunken}"
                        BorderBrush="{DynamicResource Brush.Line}"
                        BorderThickness="1"
                        Cursor="Hand"
                        Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="{DynamicResource Radius.Full}">
                                <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Step number text (active/pending) -->
                                    <TextBlock x:Name="NumText"
                                               Text="{Binding StepNumber}"
                                               FontSize="{DynamicResource Text.Xs}"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.InkMuted}" />
                                    <!-- Completed checkmark icon -->
                                    <ui:Icon x:Name="CheckIcon"
                                             Glyph="Tick" Size="14"
                                             Foreground="{DynamicResource Brush.OnPrimary}"
                                             Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Active">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                    <Setter TargetName="NumText" Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
                                    <Setter TargetName="NumText" Property="FontWeight" Value="Bold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Completed">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Primary}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                                    <Setter TargetName="NumText" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="CheckIcon" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Error">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Danger}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                                    <Setter TargetName="NumText" Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <!-- Right / Beside: Title and Description -->
            <StackPanel Grid.Column="1" Margin="8,4,12,0" VerticalAlignment="Top">
                <TextBlock x:Name="TitleText"
                           Text="{Binding Title}"
                           FontSize="{DynamicResource Text.Sm}">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.InkMuted}" />
                            <Setter Property="FontWeight" Value="Medium" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="Active">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding State}" Value="Completed">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock x:Name="DescText"
                           Text="{Binding Description}"
                           Foreground="{DynamicResource Brush.InkMuted}"
                           FontSize="{DynamicResource Text.Xs}"
                           Margin="0,2,0,0"
                           Visibility="{Binding Description, Converter={x:Static ui:PresentToVisibilityConverter.Instance}}" />
            </StackPanel>
        </Grid>
    </DataTemplate>

    <Style TargetType="{x:Type ui:SopsStepper}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:SopsStepper}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ItemsControl ItemsSource="{Binding FormattedSteps, RelativeSource={RelativeSource TemplatedParent}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
