<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <Style TargetType="{x:Type ui:ShortcutOverlay}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:ShortcutOverlay}">
                    <Grid Visibility="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:BooleanToVisibilityConverter.Instance}}">
                        <!-- Scrim / Backdrop -->
                        <Border Background="{DynamicResource Brush.Overlay}" Tag="CLOSE" Cursor="Hand" />

                        <!-- Center Dialog Card -->
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                                Width="520" MaxHeight="600"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1"
                                CornerRadius="{DynamicResource Radius.Lg}"
                                Effect="{DynamicResource Shadow.Deep}">
                            <Grid Margin="20">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <!-- Header: Title and Close button -->
                                <Grid Grid.Row="0" Margin="0,0,0,16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:Icon Glyph="Keyboard" Size="18" Foreground="{DynamicResource Brush.Primary}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{TemplateBinding Title}"
                                                   Foreground="{DynamicResource Brush.Ink}"
                                                   FontSize="{DynamicResource Text.Lg}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Tag="CLOSE"
                                            Width="28" Height="28"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Cursor="Hand">
                                        <ui:Icon Glyph="Close" Size="12" Foreground="{DynamicResource Brush.InkSubtle}" />
                                    </Button>
                                </Grid>

                                <!-- Search / Filter Input -->
                                <Border Grid.Row="1" Margin="0,0,0,16"
                                        Background="{DynamicResource Brush.SurfaceSunken}"
                                        BorderBrush="{DynamicResource Brush.Line}"
                                        BorderThickness="1"
                                        CornerRadius="{DynamicResource Radius.Md}"
                                        Height="36" Padding="8,0">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ui:Icon Grid.Column="0" Glyph="Search" Size="14"
                                                 Foreground="{DynamicResource Brush.InkSubtle}"
                                                 Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBox Grid.Column="1"
                                                 x:Name="PART_FilterBox"
                                                 Text="{Binding FilterText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Foreground="{DynamicResource Brush.Ink}"
                                                 FontSize="{DynamicResource Text.Sm}"
                                                 VerticalAlignment="Center" />
                                    </Grid>
                                </Border>

                                <!-- Shortcuts List (Grouped) -->
                                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                                    <ItemsControl ItemsSource="{Binding FilteredShortcuts, RelativeSource={RelativeSource TemplatedParent}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,16">
                                                    <!-- Category Header -->
                                                    <TextBlock Text="{Binding Key}"
                                                               Foreground="{DynamicResource Brush.InkSubtle}"
                                                               FontSize="{DynamicResource Text.Xs}"
                                                               FontWeight="Bold"
                                                               Margin="0,0,0,8" />

                                                    <!-- Items in category -->
                                                    <ItemsControl ItemsSource="{Binding}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid Margin="0,4">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <TextBlock Grid.Column="0"
                                                                               Text="{Binding Label}"
                                                                               Foreground="{DynamicResource Brush.Ink}"
                                                                               FontSize="{DynamicResource Text.Sm}"
                                                                               VerticalAlignment="Center" />
                                                                    <!-- Key Badge -->
                                                                    <Border Grid.Column="1"
                                                                            Background="{DynamicResource Brush.SurfaceSunken}"
                                                                            BorderBrush="{DynamicResource Brush.Line}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="{DynamicResource Radius.Sm}"
                                                                            Padding="8,3"
                                                                            VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding Key}"
                                                                                   FontFamily="{DynamicResource Font.Mono}"
                                                                                   FontSize="{DynamicResource Text.Xs}"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource Brush.Ink}" />
                                                                    </Border>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <!-- Footer: Hint to press Esc -->
                                <Border Grid.Row="3" Margin="0,12,0,0"
                                        BorderBrush="{DynamicResource Brush.Line}"
                                        BorderThickness="0,1,0,0"
                                        Padding="0,8,0,0">
                                    <TextBlock Text="Press Esc or click outside to dismiss"
                                               Foreground="{DynamicResource Brush.InkMuted}"
                                               FontSize="{DynamicResource Text.Xs}"
                                               HorizontalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsOpen" Value="True">
                <Setter Property="Visibility" Value="Visible" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
