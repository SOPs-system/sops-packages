<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- A 24×24 canvas keeps the glyph's viewBox fixed whatever its own
         bounds are, so every icon scales identically; the 2-unit stroke
         scales with it, like an SVG. -->
    <Style TargetType="{x:Type ui:Icon}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <!-- An icon is a picture, not text: it must not mirror in Arabic. This
             has to be a style SETTER. The control also overrides the property's
             default value, but an INHERITED FlowDirection outranks a default,
             so in an RTL window every glyph was being drawn backwards. -->
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Icon}">
                    <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="{TemplateBinding Data}"
                                  Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="2"
                                  StrokeLineJoin="Round"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round" />
                        </Canvas>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ui:BrandLogo}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
        <!-- Same reason as the Icon above: a wordmark reads left to right in
             both languages. -->
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:BrandLogo}">
                    <Viewbox Stretch="Uniform">
                        <Path Data="{DynamicResource Logo.Sop}" Fill="{TemplateBinding Foreground}" />
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
