<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- Clear / Dismiss button in suffix -->
    <Style x:Key="BarcodeInput.ClearButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Sm}">
                        <Path Data="M 4 4 L 10 10 M 10 4 L 4 10"
                              Stroke="{DynamicResource Brush.InkSubtle}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.LineSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Main BarcodeInput Control Style -->
    <Style TargetType="{x:Type ui:BarcodeInput}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="{DynamicResource Size.Hit}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:BarcodeInput}">
                    <Grid>
                        <!-- Focus Ring -->
                        <Border x:Name="FocusRingBorder"
                                Margin="{DynamicResource Ring.Margin}"
                                BorderThickness="{DynamicResource Ring.Thickness}"
                                BorderBrush="{DynamicResource Brush.FocusRing}"
                                CornerRadius="{DynamicResource Radius.MdRing}"
                                IsHitTestVisible="False"
                                Opacity="0" />

                        <!-- Outer Input Frame -->
                        <Border x:Name="PART_Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Height="{TemplateBinding Height}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Prefix: Optical Scan Icon -->
                                <Border Grid.Column="0"
                                        Width="34"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <ui:Icon Glyph="Scan"
                                             Size="16"
                                             Foreground="{DynamicResource Brush.Primary}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Border>

                                <!-- Text Box Area with Placeholder -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PART_Placeholder"
                                               Text="{TemplateBinding Placeholder}"
                                               Foreground="{DynamicResource Brush.InkSubtle}"
                                               FontSize="{TemplateBinding FontSize}"
                                               FontFamily="{DynamicResource Font.App}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:EmptyToVisibilityConverter.Instance}}" />
                                    <TextBox x:Name="PART_TextBox"
                                             Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             FontFamily="{TemplateBinding FontFamily}"
                                             FontSize="{TemplateBinding FontSize}"
                                             FontWeight="Medium"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Padding="4,0"
                                             CaretBrush="{DynamicResource Brush.Ink}"
                                             SelectionBrush="{DynamicResource Brush.Primary}"
                                             FocusVisualStyle="{x:Null}" />
                                </Grid>

                                <!-- Clear Button (only when text is not empty) -->
                                <Button x:Name="PART_ClearButton"
                                        Grid.Column="2"
                                        Style="{StaticResource BarcodeInput.ClearButton}"
                                        Margin="0,0,4,0"
                                        Visibility="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:PresentToVisibilityConverter.Instance}}" />

                                <!-- Ready Badge Slot -->
                                <Border Grid.Column="3"
                                        Margin="0,0,8,0"
                                        Padding="6,2"
                                        Background="{DynamicResource Brush.PrimarySoft}"
                                        CornerRadius="{DynamicResource Radius.Sm}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="Enter ↵"
                                               Foreground="{DynamicResource Brush.Primary}"
                                               FontSize="{DynamicResource Text.2Xs}"
                                               FontFamily="{DynamicResource Font.Mono}"
                                               FontWeight="SemiBold" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Text is empty -> show placeholder -->
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="PART_Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <!-- Hover state -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Frame" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
                        </Trigger>
                        <!-- Focus states -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_Frame" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="FocusRingBorder" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Frame" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
