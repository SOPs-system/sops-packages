<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <Style TargetType="{x:Type ui:Divider}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Xs}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Divider}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Rectangle x:Name="Start" Grid.Column="0" Height="1" Fill="{DynamicResource Brush.Line}" VerticalAlignment="Center" />
                        <TextBlock x:Name="Label" Grid.Column="1" Margin="12,0" Text="{TemplateBinding Label}" VerticalAlignment="Center" />
                        <Rectangle x:Name="End" Grid.Column="2" Height="1" Fill="{DynamicResource Brush.Line}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="End" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Start" Property="Grid.ColumnSpan" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
