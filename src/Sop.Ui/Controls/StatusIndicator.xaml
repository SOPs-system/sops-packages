<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <Style TargetType="{x:Type ui:StatusIndicator}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:StatusIndicator}">
                    <!-- The exact HTML .state-row layout: flex items-center with 8px (Space.2) gap -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="Dot"
                                 Width="{DynamicResource Size.ToastDot}"
                                 Height="{DynamicResource Size.ToastDot}"
                                 Margin="0,0,8,0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource Brush.Success}" />
                        <TextBlock Text="{TemplateBinding Text}"
                                   FontFamily="{TemplateBinding FontFamily}"
                                   FontSize="{TemplateBinding FontSize}"
                                   Foreground="{TemplateBinding Foreground}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Variant" Value="Success">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Success}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Warning">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Warning}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Danger">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Danger}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Info">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Info}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
