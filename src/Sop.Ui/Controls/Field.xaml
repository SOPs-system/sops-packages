<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- Label + control + hint/error. The error also flips ui:Field.IsInvalid
         (inherited), which every control on the form frame reads. -->
    <Style TargetType="{x:Type ui:Field}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Field}">
                    <StackPanel>
                        <TextBlock x:Name="PART_Label"
                                   Margin="0,0,0,6"
                                   FontWeight="Medium"
                                   Foreground="{DynamicResource Brush.Ink}">
                            <ContentPresenter Content="{TemplateBinding Label}" />
                            <Run x:Name="Required" Text=" *" Foreground="{DynamicResource Brush.Danger}" />
                        </TextBlock>
                        <ContentPresenter Content="{TemplateBinding Content}" />
                        <!-- The hint/error text is bound, not presented: an
                             inline ContentPresenter is one atomic run, so a
                             long hint would sit on one line and clip. -->
                        <TextBlock x:Name="Note"
                                   Margin="0,6,0,0"
                                   FontSize="{DynamicResource Text.Xs}"
                                   Foreground="{DynamicResource Brush.InkSubtle}"
                                   TextWrapping="Wrap"
                                   Text="{TemplateBinding Hint}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="PART_Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Required" Value="False">
                            <Setter TargetName="Required" Property="Text" Value="" />
                        </Trigger>
                        <Trigger Property="ui:Field.IsInvalid" Value="True">
                            <Setter TargetName="Note" Property="Text" Value="{Binding Error, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Note" Property="Foreground" Value="{DynamicResource Brush.Danger}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="ui:Field.IsInvalid" Value="False" />
                                <Condition Property="Hint" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Note" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
