<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- Value picker: an Input as the trigger (same frame as every text box)
         with a chevron in its suffix slot, and a Menu stretched to its width. -->
    <Style TargetType="{x:Type ui:Select}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Select}">
                    <Grid>
                        <ui:Input x:Name="PART_Input"
                                  Size="{TemplateBinding Size}"
                                  Placeholder="{TemplateBinding Placeholder}"
                                  IsReadOnly="{Binding Searchable, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:InverseBoolConverter.Instance}}"
                                  IsEnabled="{TemplateBinding IsEnabled}">
                            <ui:Input.Suffix>
                                <Path x:Name="Chevron"
                                      Width="12"
                                      Height="8"
                                      Data="{DynamicResource Icon.Chevron}"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource Brush.InkSubtle}"
                                      StrokeThickness="2"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </Path.RenderTransform>
                                </Path>
                            </ui:Input.Suffix>
                        </ui:Input>
                        <ui:Menu x:Name="PART_Menu"
                                 PlacementTarget="{Binding ElementName=PART_Input}"
                                 Align="Stretch"
                                 ManageFocus="False"
                                 CloseOnSelect="False"
                                 Label="{TemplateBinding MenuLabel}">
                            <Grid>
                                <TextBlock x:Name="NoMatch"
                                           Margin="10,8"
                                           FontSize="{DynamicResource Text.Sm}"
                                           Foreground="{DynamicResource Brush.InkSubtle}"
                                           Text="{TemplateBinding NoMatchLabel}"
                                           Visibility="Collapsed" />
                                <StackPanel>
                                <!-- Opening on a selection starts the list
                                     around it, so there can be options above
                                     the first row as well as below the last. -->
                                <ui:MenuItem x:Name="PART_Earlier"
                                             Content="{TemplateBinding EarlierLabel}"
                                             Visibility="Collapsed"
                                             Focusable="False" />
                                <ItemsControl x:Name="PART_Options"
                                              ItemsSource="{Binding Shown, RelativeSource={RelativeSource TemplatedParent}}"
                                              Focusable="False">
                                    <!-- A plain ItemsControl generates bare
                                         ContentPresenters, and those size to
                                         their content. Without this every
                                         option is only as wide as its own
                                         label and the highlight stops short of
                                         the popup's edge. -->
                                    <ItemsControl.ItemContainerStyle>
                                        <Style TargetType="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.ItemContainerStyle>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ui:MenuItem Content="{Binding Label}"
                                                         Selected="{Binding IsSelected}"
                                                         Active="{Binding IsActive}"
                                                         Check="{Binding ShowCheck}"
                                                         IsEnabled="{Binding IsDisabled, Converter={x:Static ui:InverseBoolConverter.Instance}}"
                                                         Focusable="False" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- The rest of a long list, one page at a
                                     time. Scrolling to the bottom loads the
                                     next ten on its own; this is the same
                                     step for a list too short to scroll, and
                                     it says plainly that more is there. -->
                                <ui:MenuItem x:Name="PART_More"
                                             Content="{TemplateBinding MoreLabel}"
                                             Visibility="Collapsed"
                                             Focusable="False" />
                                </StackPanel>
                            </Grid>
                        </ui:Menu>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- The chevron turns over while the list is open (transition-transform). -->
                        <Trigger Property="IsOpen" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="180" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Chevron" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" To="0" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut" /></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <DataTrigger Binding="{Binding Shown.Count, RelativeSource={RelativeSource Self}}" Value="0">
                            <Setter TargetName="NoMatch" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="Searchable" Value="False">
                            <Setter TargetName="PART_Input" Property="Cursor" Value="Hand" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
