<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- ====================================================================
         SopsSegmentedProgressBar: Capsule Segmented Progress Bar
         - Two horizontal pill-shaped segments (Completed & Remaining)
         - Both ends of both segments are fully rounded (pill capsule)
         - 4px gap between completed and remaining segments
         - 8px default height, radius = BarHeight / 2
         - Flat, minimal, no borders or shadows
         - Theme support (Brush.Primary & Brush.SurfaceSunken)
         ==================================================================== -->
    <Style TargetType="{x:Type ui:SopsSegmentedProgressBar}">
        <Setter Property="Height" Value="{Binding BarHeight, RelativeSource={RelativeSource Self}}" />
        <Setter Property="BarHeight" Value="8" />
        <Setter Property="SegmentGap" Value="4" />
        <Setter Property="CompletedBrush" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="RemainingBrush" Value="{DynamicResource Brush.SurfaceSunken}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:SopsSegmentedProgressBar}">
                    <Grid VerticalAlignment="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Optional percentage text above -->
                        <TextBlock x:Name="PART_PercentageLabel"
                                   Grid.Row="0"
                                   HorizontalAlignment="Right"
                                   FontSize="{DynamicResource Text.Xs}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.InkSubtle}"
                                   Margin="0,0,0,4"
                                   Visibility="Collapsed" />

                        <!-- Segments Grid -->
                        <Grid Grid.Row="1" Height="{TemplateBinding BarHeight}" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- Completed Segment Column -->
                                <ColumnDefinition x:Name="PART_ColCompleted" Width="0" />
                                <!-- Gap Column -->
                                <ColumnDefinition x:Name="PART_ColGap" Width="0" />
                                <!-- Remaining Segment Column -->
                                <ColumnDefinition x:Name="PART_ColRemaining" Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Completed Capsule Segment: Fully rounded on both ends -->
                            <Border x:Name="PART_CompletedSegment"
                                    Grid.Column="0"
                                    Background="{TemplateBinding CompletedBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Height="{TemplateBinding BarHeight}"
                                    SnapsToDevicePixels="True" />

                            <!-- Gap spacer (empty) -->
                            <Rectangle Grid.Column="1" Fill="Transparent" />

                            <!-- Remaining Capsule Segment: Fully rounded on both ends -->
                            <Border x:Name="PART_RemainingSegment"
                                    Grid.Column="2"
                                    Background="{TemplateBinding RemainingBrush}"
                                    CornerRadius="{TemplateBinding CornerRadius}"
                                    Height="{TemplateBinding BarHeight}"
                                    SnapsToDevicePixels="True" />
                        </Grid>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowPercentage" Value="True">
                            <Setter TargetName="PART_PercentageLabel" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
