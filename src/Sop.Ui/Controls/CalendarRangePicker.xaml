<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- Preset Button Style -->
    <Style x:Key="CalendarRangePicker.PresetButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Sm}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.LineSubtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Line}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CalendarRangePicker Style -->
    <Style TargetType="{x:Type ui:CalendarRangePicker}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="Height" Value="{DynamicResource Size.Hit}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:CalendarRangePicker}">
                    <Grid SnapsToDevicePixels="True">
                        <!-- Trigger / Input Display -->
                        <Button x:Name="PART_TriggerButton"
                                Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Line}"
                                BorderThickness="1"
                                Height="{TemplateBinding Height}"
                                Cursor="Hand"
                                FocusVisualStyle="{x:Null}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="{DynamicResource Radius.Md}"
                                            Padding="12,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Leading Calendar Icon -->
                                            <ui:Icon Glyph="Calendar"
                                                     Size="16"
                                                     Foreground="{DynamicResource Brush.Primary}"
                                                     Margin="0,0,10,0"
                                                     VerticalAlignment="Center" />

                                            <!-- Formatted Date Range Display -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding DisplayText, RelativeSource={RelativeSource AncestorType=ui:CalendarRangePicker}}"
                                                       Foreground="{DynamicResource Brush.Ink}"
                                                       FontSize="{DynamicResource Text.Sm}"
                                                       FontFamily="{DynamicResource Font.Mono}"
                                                       VerticalAlignment="Center" />

                                            <!-- Dropdown Chevron -->
                                            <ui:Icon Grid.Column="2"
                                                     Glyph="ChevronDown"
                                                     Size="12"
                                                     Foreground="{DynamicResource Brush.InkSubtle}"
                                                     Margin="10,0,0,0"
                                                     VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Dropdown Popup -->
                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=PART_TriggerButton}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Margin="0,4,0,0"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Lg}"
                                    Effect="{DynamicResource Shadow.Deep}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Presets Sidebar -->
                                    <Border Grid.Column="0"
                                            Background="{DynamicResource Brush.SurfaceSunken}"
                                            CornerRadius="12,0,0,12"
                                            Padding="6,8">
                                        <StackPanel>
                                            <TextBlock Text="Presets"
                                                       FontSize="{DynamicResource Text.2Xs}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.InkSubtle}"
                                                       Margin="8,4,8,8" />

                                            <Button x:Name="PART_PresetToday"
                                                    Content="Today"
                                                    Style="{StaticResource CalendarRangePicker.PresetButton}" />
                                            <Button x:Name="PART_PresetYesterday"
                                                    Content="Yesterday"
                                                    Style="{StaticResource CalendarRangePicker.PresetButton}" />
                                            <Button x:Name="PART_PresetThisWeek"
                                                    Content="This Week"
                                                    Style="{StaticResource CalendarRangePicker.PresetButton}" />
                                            <Button x:Name="PART_PresetThisMonth"
                                                    Content="This Month"
                                                    Style="{StaticResource CalendarRangePicker.PresetButton}" />
                                            <Button x:Name="PART_PresetLast30Days"
                                                    Content="Last 30 Days"
                                                    Style="{StaticResource CalendarRangePicker.PresetButton}" />
                                            <Button x:Name="PART_PresetThisYear"
                                                    Content="This Year"
                                                    Style="{StaticResource CalendarRangePicker.PresetButton}" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Divider Line -->
                                    <Border Grid.Column="1" Background="{DynamicResource Brush.Line}" />

                                    <!-- Calendar & Actions Area -->
                                    <StackPanel Grid.Column="2" Margin="12">
                                        <!-- Interactive Range Calendar -->
                                        <ui:Calendar x:Name="PART_Calendar"
                                                     SelectionMode="MultipleRange"
                                                     ui:CalendarAssist.EnableTwoClickRange="True"
                                                     HorizontalAlignment="Center" />

                                        <!-- Footer Actions -->
                                        <Border Margin="0,10,0,0"
                                                BorderBrush="{DynamicResource Brush.Line}"
                                                BorderThickness="0,1,0,0"
                                                Padding="0,10,0,0">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button x:Name="PART_CancelButton"
                                                        Content="Cancel"
                                                        Padding="12,6"
                                                        Margin="0,0,8,0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{DynamicResource Brush.InkSubtle}"
                                                        FontSize="{DynamicResource Text.Sm}"
                                                        FontWeight="Medium"
                                                        Cursor="Hand" />
                                                <Button x:Name="PART_ApplyButton"
                                                        Content="Apply Range"
                                                        Padding="16,6"
                                                        Background="{DynamicResource Brush.Primary}"
                                                        Foreground="{DynamicResource Brush.OnPrimary}"
                                                        FontSize="{DynamicResource Text.Sm}"
                                                        FontWeight="SemiBold"
                                                        Cursor="Hand">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="AppBd"
                                                                    Background="{TemplateBinding Background}"
                                                                    CornerRadius="{DynamicResource Radius.Sm}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="AppBd" Property="Background" Value="{DynamicResource Brush.PrimaryHover}" />
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Size: Sm (36px) -->
                        <Trigger Property="Size" Value="Sm">
                            <Setter Property="Height" Value="{DynamicResource Size.HitSm}" />
                        </Trigger>
                        <!-- Size: Lg (56px) -->
                        <Trigger Property="Size" Value="Lg">
                            <Setter Property="Height" Value="{DynamicResource Size.HitLg}" />
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
