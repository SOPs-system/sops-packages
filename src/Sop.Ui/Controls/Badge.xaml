<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- Status pill — order states, stock levels, payment status. -->
    <Style TargetType="{x:Type ui:Badge}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Xs}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.InkMuted}" />
        <Setter Property="Padding" Value="10,2" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Badge}">
                    <Border Background="{TemplateBinding Background}"
                            CornerRadius="{Binding Path=ActualHeight, RelativeSource={RelativeSource Self}, Converter={x:Static ui:HalfHeightToCornerRadiusConverter.Instance}}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Primary">
                <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
            </Trigger>
            <Trigger Property="Variant" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.SuccessSoftText}" />
            </Trigger>
            <Trigger Property="Variant" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Brush.WarningSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.WarningSoftText}" />
            </Trigger>
            <Trigger Property="Variant" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.DangerSoftText}" />
            </Trigger>
            <Trigger Property="Variant" Value="Info">
                <Setter Property="Background" Value="{DynamicResource Brush.InfoSoft}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.InfoSoftText}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
