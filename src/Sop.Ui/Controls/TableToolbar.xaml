<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <Style x:Key="TableToolbar.ActionButton" TargetType="{x:Type Button}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="Margin" Value="4,0,0,0" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Md}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.LineSubtle}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.Line}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ui:TableToolbar}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:TableToolbar}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel>
                            <!-- Top bar: DockPanel with Right-docked tools and Left-docked search/filter -->
                            <DockPanel LastChildFill="True">
                                <!-- Right Tools & Actions (Docked Right so they never get clipped) -->
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Item Count Display -->
                                    <TextBlock Text="{TemplateBinding ItemCountText}"
                                               Foreground="{DynamicResource Brush.InkSubtle}"
                                               FontSize="{DynamicResource Text.Sm}"
                                               VerticalAlignment="Center"
                                               Margin="24,0,12,0" />

                                    <!-- Custom User Actions Slot -->
                                    <ContentPresenter Content="{TemplateBinding ActionsSlot}" Margin="0,0,4,0" VerticalAlignment="Center" />

                                    <!-- Columns Visibility Button -->
                                    <Button Tag="COLUMNS"
                                            Style="{StaticResource TableToolbar.ActionButton}"
                                            ToolTip="Column visibility"
                                            Visibility="{Binding ShowColumns, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:BooleanToVisibilityConverter.Instance}}">
                                        <ui:Icon Glyph="PanelLeft" Size="14" Foreground="{DynamicResource Brush.InkSubtle}" />
                                    </Button>

                                    <!-- Export Button -->
                                    <Button Tag="EXPORT"
                                            Style="{StaticResource TableToolbar.ActionButton}"
                                            ToolTip="Export data"
                                            Visibility="{Binding ShowExport, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:BooleanToVisibilityConverter.Instance}}">
                                        <ui:Icon Glyph="Download" Size="14" Foreground="{DynamicResource Brush.InkSubtle}" />
                                    </Button>

                                    <!-- Refresh Button -->
                                    <Button Tag="REFRESH"
                                            Style="{StaticResource TableToolbar.ActionButton}"
                                            ToolTip="Refresh">
                                        <ui:Icon Glyph="RotateCcw" Size="14" Foreground="{DynamicResource Brush.InkSubtle}" />
                                    </Button>
                                </StackPanel>

                                <!-- Left Side: Search Box + Filters + Sort -->
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <!-- Search Box -->
                                    <Border Width="160"
                                            Background="{DynamicResource Brush.SurfaceSunken}"
                                            BorderBrush="{DynamicResource Brush.Line}"
                                            BorderThickness="1"
                                            CornerRadius="{DynamicResource Radius.Md}"
                                            Height="32"
                                            Padding="8,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <ui:Icon Grid.Column="0" Glyph="Search" Size="14"
                                                     Foreground="{DynamicResource Brush.InkSubtle}"
                                                     Margin="0,0,6,0" VerticalAlignment="Center" />

                                            <!-- Placeholder when empty -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{TemplateBinding SearchPlaceholder}"
                                                       Foreground="{DynamicResource Brush.InkMuted}"
                                                       FontSize="{DynamicResource Text.Sm}"
                                                       VerticalAlignment="Center"
                                                       IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}}" Value="">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>

                                            <!-- Actual Search TextBox -->
                                            <TextBox Grid.Column="1"
                                                     x:Name="PART_SearchBox"
                                                     Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     Foreground="{DynamicResource Brush.Ink}"
                                                     FontSize="{DynamicResource Text.Sm}"
                                                     VerticalAlignment="Center" />

                                            <!-- Clear Button -->
                                            <Button Grid.Column="2"
                                                    Tag="CLEAR_SEARCH"
                                                    Style="{StaticResource TableToolbar.ActionButton}"
                                                    Height="20" Width="20"
                                                    Padding="0" Margin="4,0,0,0"
                                                    BorderThickness="0" Background="Transparent"
                                                    Visibility="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:PresentToVisibilityConverter.Instance}}">
                                                <ui:Icon Glyph="Close" Size="10" Foreground="{DynamicResource Brush.InkSubtle}" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!-- Filter Button -->
                                    <Button Tag="FILTER"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource TableToolbar.ActionButton}"
                                            Visibility="{Binding ShowFilter, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:BooleanToVisibilityConverter.Instance}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Icon Glyph="Settings" Size="13" Foreground="{DynamicResource Brush.InkSubtle}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Filter" VerticalAlignment="Center" />
                                            <!-- Badge count if active -->
                                            <Border Background="{DynamicResource Brush.Primary}"
                                                    CornerRadius="{DynamicResource Radius.Sm}"
                                                    Margin="6,0,0,0" Padding="4,1"
                                                    VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding FilterBadgeCount, RelativeSource={RelativeSource TemplatedParent}}" Value="0">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding FilterBadgeCount, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Foreground="{DynamicResource Brush.OnPrimary}"
                                                           FontSize="{DynamicResource Text.2Xs}"
                                                           FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                    </Button>

                                    <!-- Sort Button -->
                                    <Button Tag="SORT"
                                            Margin="4,0,0,0"
                                            ToolTip="{Binding ActiveSortLabel, RelativeSource={RelativeSource TemplatedParent}}"
                                            Style="{StaticResource TableToolbar.ActionButton}"
                                            Visibility="{Binding ShowSort, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:BooleanToVisibilityConverter.Instance}}">
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Icon Glyph="Sort" Size="13" Foreground="{DynamicResource Brush.InkSubtle}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Sort" VerticalAlignment="Center" />
                                            <ui:Icon Glyph="ChevronDown" Size="10" Foreground="{DynamicResource Brush.InkSubtle}" Margin="4,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <!-- Bottom row: Active Filter Chips Slot (optional) -->
                            <ContentPresenter Content="{TemplateBinding FilterChipsSlot}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
