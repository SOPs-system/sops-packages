<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- The ring is drawn in Spinner.OnRender in the current Foreground; the
         template is an empty canvas so the control still takes part in the
         theme like every other primitive. -->
    <!-- No Foreground setter: the ring must inherit the colour of whatever it
         sits in (white inside a primary button), like CSS currentColor. -->
    <Style TargetType="{x:Type ui:Spinner}">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Spinner}">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
