<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <Style TargetType="{x:Type ui:SopsAppShell}">
        <Setter Property="Background" Value="{DynamicResource Brush.Bg}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:SopsAppShell}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Header (TopBar) -->
                        <ContentPresenter Grid.Row="0" Content="{TemplateBinding TopBar}" />

                        <!-- Middle Area: Left Sidebar + Center Workspace + Right Side Panel -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Left Side Header (Sidebar / Rail) -->
                            <ContentPresenter Grid.Column="0" Content="{TemplateBinding Sidebar}" />

                            <!-- Center Application Workspace -->
                            <ContentPresenter Grid.Column="1" />

                            <!-- Right Side Header (SidePanel / Drawer) -->
                            <ContentPresenter Grid.Column="2" Content="{TemplateBinding RightPanel}" />
                        </Grid>

                        <!-- Bottom Status Bar -->
                        <ContentPresenter Grid.Row="2" Content="{TemplateBinding StatusBar}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
