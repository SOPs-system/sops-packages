<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls"
    xmlns:root="clr-namespace:Sop.Ui">

    <!-- The masked and the clear box share one bare template: the frame,
         focus ring, prefix and eye button belong to the PasswordInput. -->
    <ControlTemplate x:Key="PasswordInput.Bare.Password" TargetType="{x:Type PasswordBox}">
        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
    </ControlTemplate>
    <ControlTemplate x:Key="PasswordInput.Bare.Text" TargetType="{x:Type TextBox}">
        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
    </ControlTemplate>

    <Style TargetType="{x:Type ui:PasswordInput}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="{DynamicResource Size.Hit}" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Input}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:PasswordInput}">
                    <Grid>
                        <Border x:Name="Ring"
                                Margin="{DynamicResource Ring.Margin}"
                                BorderThickness="{DynamicResource Ring.Thickness}"
                                BorderBrush="{DynamicResource Brush.FocusRing}"
                                CornerRadius="{DynamicResource Radius.MdRing}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                        <Border x:Name="Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Prefix"
                                                  Grid.Column="0"
                                                  Content="{TemplateBinding Prefix}"
                                                  Margin="{DynamicResource Pad.Affix.Start}"
                                                  VerticalAlignment="Center"
                                                  TextBlock.Foreground="{DynamicResource Brush.InkSubtle}" />
                                <Grid Grid.Column="1" x:Name="Boxes" Margin="{DynamicResource Pad.None}">
                                    <TextBlock x:Name="Placeholder"
                                               Text="{TemplateBinding Placeholder}"
                                               Foreground="{DynamicResource Brush.InkSubtle}"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False"
                                               Visibility="Collapsed" />
                                    <PasswordBox x:Name="PART_Password"
                                                 Template="{StaticResource PasswordInput.Bare.Password}"
                                                 Background="{x:Null}"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 FontFamily="{TemplateBinding FontFamily}"
                                                 FontSize="{TemplateBinding FontSize}"
                                                 Foreground="{TemplateBinding Foreground}"
                                                 CaretBrush="{DynamicResource Brush.Ink}"
                                                 SelectionBrush="{DynamicResource Brush.Primary}"
                                                 SelectionOpacity="0.3"
                                                 VerticalContentAlignment="Center"
                                                 VerticalAlignment="Center"
                                                 FocusVisualStyle="{x:Null}" />
                                    <TextBox x:Name="PART_Text"
                                             Template="{StaticResource PasswordInput.Bare.Text}"
                                             Background="{x:Null}"
                                             BorderThickness="0"
                                             Padding="0"
                                             FontFamily="{TemplateBinding FontFamily}"
                                             FontSize="{TemplateBinding FontSize}"
                                             Foreground="{TemplateBinding Foreground}"
                                             CaretBrush="{DynamicResource Brush.Ink}"
                                             SelectionBrush="{DynamicResource Brush.Primary}"
                                             SelectionOpacity="0.3"
                                             VerticalContentAlignment="Center"
                                             VerticalAlignment="Center"
                                             FocusVisualStyle="{x:Null}"
                                             Visibility="Collapsed" />
                                </Grid>
                                <ui:IconButton x:Name="PART_Toggle"
                                               Grid.Column="2"
                                               Size="Sm"
                                               Margin="{DynamicResource Pad.Affix.End}"
                                               VerticalAlignment="Center"
                                               IsTabStop="False"
                                               ToolTip="{TemplateBinding ToggleLabel}"
                                               AutomationProperties.Name="{TemplateBinding ToggleLabel}">
                                    <ui:Icon x:Name="ToggleGlyph" Glyph="Eye" Size="16" Foreground="{DynamicResource Brush.InkSubtle}" />
                                </ui:IconButton>
                            </Grid>
                        </Border>
                        <Border x:Name="FocusFrame"
                                BorderBrush="{DynamicResource Brush.Primary}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                IsHitTestVisible="False"
                                Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Prefix" Value="{x:Null}">
                            <Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Boxes" Property="Margin" Value="{DynamicResource Pad.InputBeforeSuffix}" />
                        </Trigger>
                        <Trigger Property="IsEmpty" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Revealed" Value="True">
                            <Setter TargetName="PART_Password" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Text" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ToggleGlyph" Property="Glyph" Value="EyeOff" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusFrame" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="FocusFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding (root:Theme.KeyboardMode), RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="ui:Field.IsInvalid" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.Danger}" />
                            <Setter TargetName="FocusFrame" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Ring" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
                            <Setter Property="Opacity" Value="0.6" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Size" Value="Sm">
                <Setter Property="Height" Value="{DynamicResource Size.HitSm}" />
                <Setter Property="Padding" Value="{DynamicResource Pad.InputSm}" />
            </Trigger>
            <Trigger Property="Size" Value="Lg">
                <Setter Property="Height" Value="{DynamicResource Size.HitLg}" />
                <Setter Property="Padding" Value="{DynamicResource Pad.InputLg}" />
                <Setter Property="FontSize" Value="{DynamicResource Text.Md}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
