<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- Clear Button in suffix -->
    <Style x:Key="AsyncLookup.ClearButton" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{DynamicResource Radius.Sm}">
                        <Path Data="M 4 4 L 10 10 M 10 4 L 4 10"
                              Stroke="{DynamicResource Brush.InkSubtle}"
                              StrokeThickness="1.5"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              SnapsToDevicePixels="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.LineSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type ui:AsyncLookup}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Height" Value="{DynamicResource Size.Hit}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:AsyncLookup}">
                    <Grid>
                        <!-- Focus Ring -->
                        <Border x:Name="FocusRingBorder"
                                Margin="{DynamicResource Ring.Margin}"
                                BorderThickness="{DynamicResource Ring.Thickness}"
                                BorderBrush="{DynamicResource Brush.FocusRing}"
                                CornerRadius="{DynamicResource Radius.MdRing}"
                                IsHitTestVisible="False"
                                Opacity="0" />

                        <!-- Outer Input Frame -->
                        <Border x:Name="PART_Frame"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                Height="{TemplateBinding Height}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Prefix: Search Icon -->
                                <Border Grid.Column="0"
                                        Width="34"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                    <ui:Icon Glyph="Search"
                                             Size="16"
                                             Foreground="{DynamicResource Brush.InkSubtle}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center" />
                                </Border>

                                <!-- Query TextBox with Placeholder -->
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PART_Placeholder"
                                               Text="{TemplateBinding Placeholder}"
                                               Foreground="{DynamicResource Brush.InkSubtle}"
                                               FontSize="{TemplateBinding FontSize}"
                                               VerticalAlignment="Center"
                                               Margin="4,0,0,0"
                                               IsHitTestVisible="False"
                                               Visibility="{Binding Query, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:EmptyToVisibilityConverter.Instance}}" />
                                    <TextBox x:Name="PART_TextBox"
                                             Text="{Binding Query, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{TemplateBinding Foreground}"
                                             FontSize="{TemplateBinding FontSize}"
                                             VerticalAlignment="Center"
                                             VerticalContentAlignment="Center"
                                             Padding="4,0"
                                             CaretBrush="{DynamicResource Brush.Ink}"
                                             SelectionBrush="{DynamicResource Brush.Primary}"
                                             FocusVisualStyle="{x:Null}" />
                                </Grid>

                                <!-- Spinner (when IsLoading is true) -->
                                <ui:Spinner Grid.Column="2"
                                            Size="Sm"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsLoading, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:PresentToVisibilityConverter.Instance}}" />

                                <!-- Clear Button -->
                                <Button x:Name="PART_ClearButton"
                                        Grid.Column="3"
                                        Style="{StaticResource AsyncLookup.ClearButton}"
                                        Margin="0,0,6,0"
                                        Visibility="{Binding Query, RelativeSource={RelativeSource TemplatedParent}, Converter={x:Static ui:PresentToVisibilityConverter.Instance}}" />
                            </Grid>
                        </Border>

                        <!-- Dropdown Popup for Matches -->
                        <Popup x:Name="PART_Popup"
                               PlacementTarget="{Binding ElementName=PART_Frame}"
                               Placement="Bottom"
                               IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Margin="{DynamicResource Pad.MenuShadowBleed}"
                                    MinWidth="{Binding ActualWidth, ElementName=PART_Frame}"
                                    MaxHeight="260"
                                    Background="{DynamicResource Brush.SurfaceRaised}"
                                    BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Lg}"
                                    Effect="{DynamicResource Shadow.Deep}"
                                    Padding="4">
                                <ListBox x:Name="PART_ListBox"
                                         ItemsSource="{Binding ItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                         ItemTemplate="{Binding ItemTemplate, RelativeSource={RelativeSource TemplatedParent}}"
                                         SelectedItem="{Binding SelectedItem, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Focus states -->
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_Frame" Property="BorderBrush" Value="{DynamicResource Brush.Primary}" />
                            <Setter TargetName="FocusRingBorder" Property="Opacity" Value="1" />
                        </Trigger>
                        <!-- Hover states -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Frame" Property="BorderBrush" Value="{DynamicResource Brush.LineStrong}" />
                        </Trigger>
                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Frame" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
