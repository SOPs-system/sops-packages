<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- Standard Continuous ProgressBar -->
    <Style TargetType="{x:Type ProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceSunken}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ProgressBar}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Sm}" Height="{TemplateBinding Height}" ClipToBounds="True">
                        <Grid x:Name="PART_Track">
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="{DynamicResource Radius.Sm}" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Android Material 3 Style Gapped / Segmented Progress Indicator -->
    <Style TargetType="{x:Type ui:GappedProgressBar}">
        <Setter Property="Height" Value="6" />
        <Setter Property="TrackHeight" Value="6" />
        <Setter Property="Gap" Value="{DynamicResource Space.1}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:GappedProgressBar}">
                    <UniformGrid x:Name="PART_Container" Rows="1" Height="{TemplateBinding TrackHeight}" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
