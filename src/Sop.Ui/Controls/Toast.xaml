<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:Sop.Ui.Controls">

    <!-- The small dismiss control inside a toast: no chrome, just the glyph. -->
    <Style x:Key="Sop.Toast.Dismiss" TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.InkSubtle}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border Background="{TemplateBinding Background}" CornerRadius="{DynamicResource Radius.Sm}" Padding="{TemplateBinding Padding}">
                        <Path Width="12"
                              Height="12"
                              Data="{DynamicResource Icon.Close}"
                              Stretch="Uniform"
                              Stroke="{TemplateBinding Foreground}"
                              StrokeThickness="2"
                              StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ui:Toast}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceRaised}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Width" Value="{DynamicResource Size.ToastWidth}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:Toast}">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{DynamicResource Radius.Lg}"
                            Effect="{DynamicResource Shadow.Deep}"
                            Padding="{TemplateBinding Padding}"
                            RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="Scale" />
                                <TranslateTransform x:Name="Slide" />
                            </TransformGroup>
                        </Border.RenderTransform>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="Dot"
                                     Grid.Column="0"
                                     Width="{DynamicResource Size.ToastDot}"
                                     Height="{DynamicResource Size.ToastDot}"
                                     Margin="0,6,12,0"
                                     VerticalAlignment="Top"
                                     Fill="{DynamicResource Brush.InkSubtle}" />
                            <StackPanel Grid.Column="1">
                                <ContentPresenter Content="{TemplateBinding Title}" TextBlock.FontWeight="SemiBold">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <ContentPresenter x:Name="Subtitle"
                                                  Content="{TemplateBinding Subtitle}"
                                                  Margin="0,2,0,0"
                                                  TextBlock.FontSize="{DynamicResource Text.Xs}"
                                                  TextBlock.Foreground="{DynamicResource Brush.InkMuted}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                            <Button x:Name="PART_Dismiss"
                                    Grid.Column="2"
                                    Margin="12,-4,-4,0"
                                    Style="{StaticResource Sop.Toast.Dismiss}"
                                    AutomationProperties.Name="Dismiss" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Dismissable" Value="False">
                            <Setter TargetName="PART_Dismiss" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Success">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Success}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessLineStrong}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Warning">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Warning}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.WarningLineStrong}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Danger">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Danger}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerLineStrong}" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Info">
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Brush.Info}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.InfoLineStrong}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
