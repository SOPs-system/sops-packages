<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="clr-namespace:Sop.Ui.Controls"
                    xmlns:root="clr-namespace:Sop.Ui">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Sop.Ui;component/Controls/Icon.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ==================== SplitButton Style ==================== -->
    <Style TargetType="{x:Type ui:SplitButton}">
        <Setter Property="FontFamily" Value="{DynamicResource Font.App}" />
        <Setter Property="FontSize" Value="{DynamicResource Text.Sm}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="{DynamicResource Size.Hit}" />
        <Setter Property="Background" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="{DynamicResource Pad.Button}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ui:SplitButton}">
                    <ControlTemplate.Resources>
                        <Style TargetType="{x:Type ui:Icon}" BasedOn="{StaticResource {x:Type ui:Icon}}">
                            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:SplitButton}}}" />
                        </Style>
                    </ControlTemplate.Resources>
                    <Grid SnapsToDevicePixels="True">
                        <!-- Main unified container -->
                        <Border x:Name="OuterBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource Radius.Md}"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Primary Button -->
                                <Button x:Name="PART_PrimaryButton"
                                        Grid.Column="0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{TemplateBinding Foreground}"
                                        FontSize="{TemplateBinding FontSize}"
                                        FontWeight="{TemplateBinding FontWeight}"
                                        FontFamily="{TemplateBinding FontFamily}"
                                        Padding="{TemplateBinding Padding}"
                                        HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                        Cursor="Hand"
                                        FocusVisualStyle="{x:Null}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="BtnBd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="{DynamicResource Radius.Md}"
                                                    Padding="{TemplateBinding Padding}">
                                                <StackPanel Orientation="Horizontal"
                                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                                    <ContentPresenter x:Name="IconHost"
                                                                      Content="{Binding Icon, RelativeSource={RelativeSource AncestorType={x:Type ui:SplitButton}}}"
                                                                      Margin="0,0,8,0"
                                                                      VerticalAlignment="Center"
                                                                      Visibility="Collapsed" />
                                                    <ContentPresenter Content="{Binding Content, RelativeSource={RelativeSource AncestorType={x:Type ui:SplitButton}}}"
                                                                      VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource Brush.LineSubtle}" />
                                                    <Setter TargetName="BtnBd" Property="Opacity" Value="0.9" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Vertical Divider -->
                                <Border x:Name="PART_Divider"
                                        Grid.Column="1"
                                        Width="1"
                                        Margin="0,4"
                                        Background="{DynamicResource Brush.OnPrimary}"
                                        Opacity="0.25"
                                        SnapsToDevicePixels="True" />

                                <!-- Dropdown Chevron Toggle Button -->
                                <ToggleButton x:Name="PART_DropDownButton"
                                              Grid.Column="2"
                                              Width="34"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              FocusVisualStyle="{x:Null}"
                                              IsChecked="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border x:Name="ToggleBd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="{DynamicResource Radius.Md}">
                                                <ui:Icon x:Name="ChevronIco"
                                                         Glyph="ChevronDown"
                                                         Size="12"
                                                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:SplitButton}}}"
                                                         HorizontalAlignment="Center"
                                                         VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ToggleBd" Property="Background" Value="{DynamicResource Brush.LineSubtle}" />
                                                    <Setter TargetName="ToggleBd" Property="Opacity" Value="0.9" />
                                                </Trigger>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ToggleBd" Property="Background" Value="{DynamicResource Brush.Line}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>
                        </Border>

                        <!-- Dropdown Popup -->
                        <Popup x:Name="PART_Popup"
                               IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                               PlacementTarget="{Binding ElementName=OuterBorder}"
                               Placement="{TemplateBinding DropDownPlacement}"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Margin="0,4,0,0"
                                    Background="{DynamicResource Brush.Surface}"
                                    BorderBrush="{DynamicResource Brush.Line}"
                                    BorderThickness="1"
                                    CornerRadius="{DynamicResource Radius.Md}"
                                    Effect="{DynamicResource Shadow.Deep}"
                                    Padding="4"
                                    MinWidth="160"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter Content="{TemplateBinding DropDownContent}" />
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Has Icon -->
                        <Trigger Property="Icon" Value="{x:Null}">
                            <!-- IconHost collapsed by default -->
                        </Trigger>

                        <!-- Size: Sm (36px) -->
                        <Trigger Property="Size" Value="Sm">
                            <Setter Property="Height" Value="{DynamicResource Size.HitSm}" />
                            <Setter Property="Padding" Value="{DynamicResource Pad.ButtonSm}" />
                            <Setter TargetName="PART_DropDownButton" Property="Width" Value="28" />
                        </Trigger>

                        <!-- Size: Lg (56px) -->
                        <Trigger Property="Size" Value="Lg">
                            <Setter Property="Height" Value="{DynamicResource Size.HitLg}" />
                            <Setter Property="Padding" Value="{DynamicResource Pad.ButtonLg}" />
                            <Setter TargetName="PART_DropDownButton" Property="Width" Value="40" />
                        </Trigger>

                        <!-- Variant: Secondary -->
                        <Trigger Property="Variant" Value="Secondary">
                            <Setter Property="Background" Value="{DynamicResource Brush.Surface}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                            <Setter TargetName="PART_Divider" Property="Background" Value="{DynamicResource Brush.Line}" />
                            <Setter TargetName="PART_Divider" Property="Opacity" Value="1.0" />
                        </Trigger>

                        <!-- Variant: Soft -->
                        <Trigger Property="Variant" Value="Soft">
                            <Setter Property="Background" Value="{DynamicResource Brush.PrimarySoft}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrimarySoftBorder}" />
                            <Setter TargetName="PART_Divider" Property="Background" Value="{DynamicResource Brush.PrimarySoftBorder}" />
                            <Setter TargetName="PART_Divider" Property="Opacity" Value="1.0" />
                        </Trigger>

                        <!-- Variant: Danger -->
                        <Trigger Property="Variant" Value="Danger">
                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.OnPrimary}" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="PART_Divider" Property="Background" Value="{DynamicResource Brush.OnPrimary}" />
                            <Setter TargetName="PART_Divider" Property="Opacity" Value="0.25" />
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
