<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Sops.Licensing</PackageId>
    <Version>0.1.0</Version>
    <Description>Production-quality, cross-platform licensing, entitlement evaluation, digital certificate validation, device identity binding, and OS-specific secure storage infrastructure for SOPs applications.</Description>
    <Authors>SOPs Team</Authors>
    <Company>SOPs</Company>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sops.Configuration\Sops.Configuration.csproj" />
    <ProjectReference Include="..\Sops.Logging\Sops.Logging.csproj" />
    <ProjectReference Include="..\Sops.Device\Sops.Device.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sops.Licensing.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options" />
    <PackageReference Include="System.ComponentModel.Annotations" />
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>

</Project>
